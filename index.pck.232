uniform vec4 tint : source_color = vec4(.2,.3,.4,1);
varying vec2 piece_state;
void vertex(){piece_state=INSTANCE_CUSTOM.xy;}
void fragment(){
 float a=abs(UV.x-.48-sin(UV.y*23.0+piece_state.y)*.045);
 float b=abs(UV.y-.43-sin(UV.x*19.0+piece_state.y)*.06);
 float crack=1.0-smoothstep(.006,.018,min(a,b));
 ALBEDO=tint.rgb*(1.0-crack*piece_state.x*.85);ROUGHNESS=.78;
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type spatial;
render_mode cull_disabled;
uniform vec4 tint : source_color = vec4(.2,.7,.8,.4);
void fragment(){ALBEDO=tint.rgb;ALPHA=.4;ROUGHNESS=.18;}
