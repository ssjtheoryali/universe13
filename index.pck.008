œÔ«}IÓfÔ™›™ÍùíÜ›£êa˝áéPK|Ò¢‹‚1ß≤◊<Ù¶v◊¡≤}åa6¬4:´ˇ∫„eõ˘ç…Nv˙ÎJ˙û7Y7‹G.Èµcf¡Öc∂¨‡{-,ﬁø6±æ≠ˆŸƒô1Ùﬂ#Ù?ô¬º°ò;ß›>ÒØÕ∞êÔ–{KÓr–Å»Î2Ú\›k}ãÊa\ù∏i”dµ◊…W¨ú˛ÅÎ>‹c„ø$Ælo–≤»nY/ßœ*[Éƒº—ûeÚn:_û†ÃÔ«~[èXπÑ¿ı˚û’ÙÙ˙7ƒ_ËãÏ}~v;OoÂ•ü£t;˛<O˜ÛÔô˚fæ˚çø_æÚË¸›îuπiã}‚“◊=±0À¨ùW±Kˇ‡aœC˛˙	ñﬁœNØôÓ»Ò€ëm¸¶˝Ò#ø¡¢>t&G;º<¬…5}›€NÙ„%¶¶.≥aı2 l¢DòMÂ^˚˜lÙu}∂”æ«ÿí.}Ú}±ªÜPo}aLƒ÷€wzºƒ~áÏKp˝[…¥ñ"<eÇ›Y˜ênÖd?ÇªŒø‘C;0&rRr/Û∂„¢ÈU<}<£Nà-∫=.∂JÇGq◊n#W≤/∆ˇ9∫›˙ÙxÓË-û9T+bﬂ'ü&..äO∞æªÛOhù*x0Ï∂‹-¿æ—[„ã˚è{º£<`3µÑxq_ˇQU¬¥¶˛∏Ï"Àºâˆˆx«˜y~\›H◊∏•ˇï:ÇŒAûâ|¯(}ùì[,ûıUbíÇ£ˇ€VÓÿÅÏ¥á|Y–_å¥Pøã\@ß_j˛ü¯Mø›˛W‡<y¬>ºët·∆ˇ9‚Õ|“^E>Ä£˜ÿÙ9u5R±üÎã‘·H2ûN:Ä˚^s±ãzs—˚¯‹(Ó␀␀␀␀␀␀␀␀␀␀␀// UNIVERSE 13 ¬∑ STORY MAP ¬∑ the ground, cel-shaded (Theory 2026-10-12: "polished for a cel shade 4k make over, Tears of the Kingdom").
// Same per-biome blend as game/terrain.gdshader (Poly Haven CC0 surfaces), but painted: texture noise is flattened toward each
// surface's own average colour, the palette is pushed to the TotK feel (warm yellow-green grass, ochre stone, cool blue shade),
// and light falls in a soft two-tone band with cool shadows and a thin sun rim instead of smooth physical shading.
shader_type spatial;
render_mode cull_back;

uniform sampler2D t_grass : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_sandstone : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_gravel : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_ash : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_sand : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_rock : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_snow : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_grass : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_rock : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_sand : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float scale = 0.22;
uniform float paint = 0.62;                       // 0 = photo texture, 1 = flat painted colour
uniform vec3 grass_col : source_color = vec3(0.44, 0.66, 0.20);
uniform vec3 stone_col : source_color = vec3(0.78, 0.64, 0.44);
uniform vec3 rock_col : source_color = vec3(0.62, 0.55, 0.50);
uniform vec3 sand_col : source_color = vec3(0.84, 0.72, 0.50);
uniform vec3 ash_col : source_color = vec3(0.66, 0.40, 0.30);
uniform vec3 gravel_col : source_color = vec3(0.62, 0.70, 0.78);
uniform vec3 snow_col : source_color = vec3(0.95, 0.97, 1.0);
uniform vec3 shade_col : source_color = vec3(0.42, 0.50, 0.72);   // the cool TotK shadow
uniform float band_lo = 0.02;
uniform float band_hi = 0.22;
uniform float rim_k = 0.18;

varying vec3 wpos;
varying vec3 wnorm;
varying vec4 wb;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnorm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	wb = CUSTOM0;
}

// the texture's detail, painted over: keep its light/dark shapes, take the colour from the palette
vec3 painted(sampler2D t, vec2 uv, vec3 pal) {
	vec3 a = texture(t, uv).rgb;
	vec3 big = texture(t, mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8)) * uv * 0.19).rgb;
	vec3 det = mix(a, big, 0.45);
	float l = dot(det, vec3(0.299, 0.587, 0.114));
	float lavg = dot(textureLod(t, uv, 9.0).rgb, vec3(0.299, 0.587, 0.114)) + 0.001;
	vec3 flat_col = pal * clamp(mix(1.0, l / lavg, 0.35), 0.75, 1.2);   // soft painted value variation
	return mix(det, flat_col, paint);
}

vec3 tri(sampler2D t, vec3 p, vec3 n) {
	vec3 w = pow(abs(n), vec3(4.0)); w /= (w.x + w.y + w.z);
	return texture(t, p.zy).rgb * w.x + texture(t, p.xz).rgb * w.y + texture(t, p.xy).rgb * w.z;
}

void fragment() {
	vec2 uv = wpos.xz * scale;
	vec4 wa = COLOR;
	float total = wa.r + wa.g + wa.b + wa.a + wb.r + wb.g + wb.b + wb.a + 0.0001;
	vec3 col = vec3(0.0);
	if (wa.r > 0.01) col += painted(t_grass, uv, grass_col) * wa.r;
	if (wa.g > 0.01) col += painted(t_sandstone, uv * 0.7, stone_col) * wa.g;
	if (wa.b > 0.01) col += painted(t_gravel, uv, gravel_col) * wa.b;
	if (wa.a > 0.01) col += painted(t_ash, uv * 0.8, ash_col) * wa.a;
	if (wb.r > 0.01) col += painted(t_sand, uv * 0.8, sand_col) * wb.r;
	if (wb.g > 0.01) col += painted(t_rock, uv * 0.6, rock_col) * wb.g;
	if (wb.b > 0.01) col += painted(t_snow, uv * 0.7, snow_col) * wb.b;
	if (wb.a > 0.01) col += painted(t_sand, uv * 0.8, sand_col * vec3(0.7, 0.74, 0.74)) * wb.a;
	col /= total;
	// steep faces are bare painted rock with soft horizontal strata (TotK cliffs)
	float steep = 1.0 - smoothstep(0.52, 0.78, wnorm.y);
	if (steep > 0.01) {
		vec3 r = tri(t_rock, wpos * scale * 0.55, wnorm);
		float l = dot(r, vec3(0.299, 0.587, 0.114));
		float strata = 0.92 + 0.08 * sin(wpos.y * 0.9);
		col = mix(col, rock_col * mix(0.85, 1.12, l) * strata, steep * (1.0 - wb.b * 0.5));
	}
	ALBEDO = col;
	ROUGHNESS = 0.95;
	SPECULAR = 0.15;
	vec3 nm = (wb.r + wb.a > 0.5) ? texture(n_sand, uv * 0.8).rgb : texture(n_grass, uv).rgb;
	if (steep > 0.01) nm = mix(nm, texture(n_rock, uv * 0.6).rgb, steep);
	NORMAL_MAP = nm;
	NORMAL_MAP_DEPTH = 0.35;   // cel: big shapes read, small bumps stay quiet
}

void light() {
	float ndl = dot(NORMAL, LIGHT);
	float lit = smoothstep(band_lo, band_hi, ndl) * ATTENUATION;
	vec3 shade = shade_col * 0.35;                                  // the unlit side is cool, never black
	DIFFUSE_LIGHT += LIGHT_COLOR * mix(shade, vec3(1.0), lit) / PI;
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 4.0) * lit;
	DIFFUSE_LIGHT += LIGHT_COLOR * rim * rim_k / PI;
}
