π„Á∂ ï‹ÀJ⁄=ˆÓ¬sÔØØ©~˙‘ÔŸÄØ¸∆ˆ ∑–#m¬©◊3_ƒÃ-{Åﬂ![+y= ΩÂ∞F4üœ„4≤8"oÅ¯Á∞`«•ÇËC|c·LÛKªÈ◊ŸDÕüﬁ›÷û_nÙ“˜ä¯LŒ˙îné∫Ú(†◊√9≥˘„'Éø˜h8˜á<\Ì;[“Ω‹'ﬂ≈ˇ∏`¸,¨©ºê4Ê1R∆√},üøjöÒ‡ƒ}±ıyﬁ“ƒ(∞˜0;”≤Ôû‹iNã|«í_#¸î¸!E˝	y"§h´ß∂©]˛⁄˙cÀˇS•˜åˆ#≠äsª„Û¢ÖË:,Ï;PŒ|Yˆü•ÌoÏEexóå>πéÉkËÁ∫æáËo$ñ‹|Ç]Ÿ{dÁÇˇÁøE ˇπ∫˛Ÿ•'ÄWÊ≤HÓèlrg›7o.í_œZ¸ßWúè}äüœoﬂ¨gñ<?ﬂº;§°ÉlV®såÔw£IO‘?ö¡‚±Uèﬁ7œ:œ5ˆ"9áñÿàFYˆÏ0£+'√ô÷Eróæë‘üÜX‹˘˘l—Õ71gÖ_VâÇ`1hxÂŒ=|ˇ¸Ñì’±¨•kx ç¿Ó1ôÅ–W∂RñX°u0zß]ÙÍ`«//@QﬂNÌ"Œ—˛¥!?:∆é?äﬂàÍåd0ºÒLÁòJgÕ€ú¸¨]π⁄]8v/¡ä#∞?∫+*3yËÎ\“‰*>Òæ˛ŸûÒÛ1	üRp¸∫ßcÚ6•ñ~µw‹/˛›_åN&z6ﬂ1'wÂ¥ñGx¶DJ>Uwpøl ˛»[¯C¨Ø8˘#6d ∂¯úπSñe√◊•úÁΩnËœæœΩèu:,HÔ´␀␀␀␀␀␀␀// UNIVERSE 13 ¬∑ MEGA CITY 13 facades, cel-shaded (story map). Same one-shader skyline as game/city_facade.gdshader, but:
// the window grid fades to the facade's painted average as it shrinks on screen (no pixel shimmer / noise from afar),
// warm painted stone + cool glass in the TotK palette, soft two-tone light with cool shade, no mirror metal.
shader_type spatial;
render_mode cull_back;

uniform vec3 stone_a : source_color = vec3(0.56, 0.60, 0.72);
uniform vec3 stone_b : source_color = vec3(0.86, 0.76, 0.62);
uniform vec3 glass : source_color = vec3(0.30, 0.48, 0.62);
uniform vec3 lit_a : source_color = vec3(1.0, 0.82, 0.5);
uniform vec3 lit_b : source_color = vec3(0.55, 0.85, 1.0);
uniform vec3 shade_col : source_color = vec3(0.42, 0.50, 0.72);
uniform float glow = 0.6;
uniform bool merged = false;          // mega_city_13.gd: towers merged per chunk carry their id in COLOR (r = id, g = brick, b = glass)
uniform vec3 brick : source_color = vec3(0.74, 0.44, 0.34);

varying vec3 wp;
varying vec3 wn;
varying vec3 vid;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	vid = COLOR.rgb;
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

void fragment() {
	vec3 n = abs(wn);
	float tower = merged ? vid.r : hash(floor(NODE_POSITION_WORLD.xz * 0.1));
	vec2 uv = n.x > n.z ? wp.zy : wp.xy;
	vec2 cs = mix(vec2(3.0, 3.6), vec2(4.2, 4.0), tower);
	vec2 g = uv / cs;
	vec2 cell = floor(g); vec2 f = fract(g);
	float band = step(0.5, fract(tower * 7.3));
	float win = mix(step(0.14, f.x) * step(f.x, 0.86) * step(0.22, f.y) * step(f.y, 0.82), step(0.04, f.x) * step(0.1, f.y), band);
	// screen-size fade: when a window is under ~4 px the grid becomes its average (that was the noise)
	float px = length(fwidth(g));
	float detail = 1.0 - smoothstep(0.12, 0.35, px);
	float avg_win = mix(0.38, 0.86, band);
	float w = mix(avg_win, win, detail);
	float on = step(0.62, hash(cell + tower * 31.0)) * detail;
	vec3 base = mix(stone_a, stone_b, tower);
	if (merged) base = mix(base, brick * mix(0.85, 1.1, tower), vid.g);
	// floor bands every 4 storeys: the towers read as built, even from far
	float floors = step(0.92, fract(uv.y / (cs.y * 4.0)));
	vec3 col = mix(base, glass, w * (merged ? mix(0.45, 0.9, vid.b) : 0.75));
	col = mix(col, base * 1.12, floors * 0.7);
	float roof = step(0.7, n.y);
	ALBEDO = mix(col, vec3(0.62, 0.60, 0.58), roof);
	ROUGHNESS = 0.9;
	SPECULAR = 0.2;
	EMISSION = win * on * (1.0 - roof) * mix(lit_a, lit_b, hash(cell * 1.7)) * glow;
}

void light() {
	float ndl = dot(NORMAL, LIGHT);
	float lit = smoothstep(0.02, 0.2, ndl) * ATTENUATION;
	DIFFUSE_LIGHT += LIGHT_COLOR * mix(shade_col * 0.35, vec3(1.0), lit) / PI;
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 4.0) * lit;
	DIFFUSE_LIGHT += LIGHT_COLOR * rim * 0.15 / PI;
}
