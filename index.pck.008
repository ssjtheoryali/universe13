 "schema": "u13.fairy_species.v1",
 "status": "test",
 "status_note": "SYSTEM TEST creature for the fairy kit + fauna AI. Not final art, not on Theory's approved roster.",
 "id": "velvetwisp",
 "name": "Velvetwisp",
 "plan": "winged_flyer",
 "lore": "A soft night moth fairy that sips moonbloom nectar. Its abdomen glows faintly so the swarm can find each other in the dark.",
 "size_m": 0.26,
 "proportions": {"thorax": 0.17, "abdomen": 0.5, "abd_w": 0.13, "head": 0.12, "leg": 0.22, "span": 2.5, "hind_wing": 0.72, "antenna": 0.4, "chord": 0.6},
 "colors": {"body": "#C9B8E8", "belly": "#F1EAFB", "accent": "#8E7CC3", "accent2": "#F6E7A8", "eye": "#2A2244", "dark": "#4A3D6B", "glow": "#FFF2B0"},
 "parts": {"wings": "insect4", "tail": "lantern", "horns": "none", "fins": "none", "legs": 6, "ears": "none", "eyes": "compound", "pattern": "eyespots", "extras": ["feather_antennae", "ruff", "lantern"]},
 "biology": {
  "habitat": ["meadow", "forest_edge"], "biome": "night meadows full of moonbloom flowers",
  "diet": "herbivore", "food": ["moonbloom nectar"],
  "activity": "nocturnal", "group": "flock", "group_size": [6, 12],
  "predators": ["gloamquill", "pebblehop", "cirrusong"], "prey": [],
  "sleep_site": "roost_leaf_underside", "nest": "rests by day under broad leaves in the tree line, wings tented",
  "locomotion": ["air", "ground"], "wingbeat_hz": 9, "drinks": false, "lifespan_years": 1, "size_class": "tiny",
  "notes": "Feathery antennae smell flowers from far; eyespots on the wings startle birds; erratic zig-zag flight dodges the owl. Gets water from nectar, so it never visits the pond."
 },
 "behavior": {"temperament": "shy", "flight_distance": 5, "curiosity": 0.5, "aggression": 0.0, "play": 0.4, "groom": 0.5, "call": "silent - glow pulses", "call_times": ["night"], "light_attraction": 0.7},
