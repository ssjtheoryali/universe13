Î1ö’<Ω˚jl	q¢ÙÙYï≈€©3ŒfúüÉ®Ás¯sı≤ˇOÓ˚Ó¶ƒoÇuwàR>yäaî€ı˛Ä2QÓÈG¥¸∆|O,û˘÷«W‹˚™:º.:Œ"˝˜≥NËm∆Ë]$Ï8␀ñë=ññ?ö…K–‹Úº©Là}7Ω_˚tñ√+˙88ÎŸ‰`Úå Û˜U›–>èÆºÿ‘´aƒ∫B8ô∫Îj5‡≥+œwÒùÔ]’/ÿŸ÷}¢w=≤º7xÙÖï«wÍπx'˘>bK/ï‹ûé\èÕ3Uö1jÿµ˙UœºÓæ˛˛ö{ˇı[˜Q¡?ÇãöÀãTu≥æIQCﬂu∂4mja+sªÜ0T[˝∑+1˘ù◊•ü¸bÿÛ‡¨£&2;ÿçdÑ6ùQn§_¸O$>bËLﬂ[’}ñª‰ﬂ˛=—≈ê¿ÚMâ Ö’ZßrŸáªá˚Œ∞≤˜2˜eˆ∏/f˝óü(ƒn"ˆÁˇÀ$íÔU˝˚~º§à¯␀␀// UNIVERSE 13 ¬∑ ink outline (inverted hull) for the cel look: drawn as next_pass on buildings + landmarks in 4K mode.
shader_type spatial;
render_mode unshaded, cull_front, depth_draw_opaque;

uniform vec3 ink : source_color = vec3(0.13, 0.11, 0.16);
uniform float width = 0.06;          // metres at the model's own scale
uniform float far_fade = 260.0;      // outlines thin out with distance (no black mush on far hills)

void vertex() {
	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float d = length(wp - CAMERA_POSITION_WORLD);
	float w = width * clamp(1.0 - d / far_fade, 0.0, 1.0);
	VERTEX += NORMAL * w;
}

void fragment() {
	ALBEDO = ink;
}
