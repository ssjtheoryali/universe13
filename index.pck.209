// UNIVERSE 13 Â· POWER ROYALE Â· CEL-SHADE REALISM (owner 2026-10-20: "textures on par with the cel shade realism we are going for",
// TotK / Fortnite feel). One material for everything the royale draws (royale/cel_real.gd):
//   * the model's real detail stays: albedo texture x colour x vertex colour, its normal map, its roughness
//   * the hand kit (U13_HandToon: colour only in the vertex colours) gets world-space stone detail (triplanar, no UVs) with the
//     stone's own normal map - cobblestone on floors, brick on light walls, rock on dark walls - so nothing reads as a flat fill
//   * light: a 3-band toon ramp (shade / mid / lit) with a soft terminator, a toon specular band driven by roughness, a rim
//   * damage (breakable building pieces, royale_destruct.gd): cracks + soot from the stone pattern, 0 intact .. 1 critical
// Brightness matches the balanced cel pass (game/gfx_cel.gd cel_detail.gdshader: DIFFUSE x2 / PI, same rim).

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform bool has_albedo = false;
uniform vec4 albedo_col : source_color = vec4(1.0);
uniform bool use_vcol = false;
uniform vec3 uv_scale = vec3(1.0);
uniform vec3 uv_offset = vec3(0.0);
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform bool has_normal = false;
uniform float normal_depth = 1.0;
uniform sampler2D rough_tex : hint_roughness_g, filter_linear_mipmap, repeat_enable;
uniform bool has_rough = false;
uniform float roughness = 0.8;
uniform vec4 emission_col : source_color = vec4(0.0);
// the model's emission MAP (a vending screen, traffic-light lenses): without it a white emission colour lit the whole model
uniform sampler2D emission_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform bool has_emission_tex = false;
// triplanar stone detail (the bake-off textures)
uniform bool use_detail = false;
uniform sampler2D brick_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D cobble_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D brick_n : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D cobble_n : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_n : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float brick_scale = 0.33;
uniform float cobble_scale = 0.5;
uniform float rock_scale = 0.2;
uniform float detail = 0.4;
uniform float detail_normal = 0.4;
uniform float damage : hint_range(0.0, 1.0) = 0.0;
// look
uniform float terminator = -0.35;  // wrap: the shade band starts this far round the back (matches the soft TOON brightness)
uniform float lit_at = 0.2;        // where the fully lit band begins
uniform float band_mid = 0.72;     // the mid band's light
uniform float soft = 0.06;         // terminator softness
uniform float rim = 0.4;
uniform float rim_tint = 0.7;

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 tri_w(vec3 n) {
	vec3 w = pow(abs(n), vec3(6.0));
	return w / (w.x + w.y + w.z);
}

vec4 tri(sampler2D t, vec3 p, vec3 w, float s) {
	return texture(t, p.zy * s) * w.x + texture(t, p.xz * s) * w.y + texture(t, p.xy * s) * w.z;
}

// triplanar normal (UDN blend) in world space
vec3 tri_n(sampler2D t, vec3 p, vec3 n, vec3 w, float s) {
	vec3 tx = texture(t, p.zy * s).xyz * 2.0 - 1.0;
	vec3 ty = texture(t, p.xz * s).xyz * 2.0 - 1.0;
	vec3 tz = texture(t, p.xy * s).xyz * 2.0 - 1.0;
	vec3 nx = vec3(0.0, tx.y, tx.x) * sign(n.x);
	vec3 ny = vec3(ty.x, 0.0, ty.y) * sign(n.y);
	vec3 nz = vec3(tz.x, tz.y, 0.0) * sign(n.z);
	return normalize(n + (nx * w.x + ny * w.y + nz * w.z));
}

void fragment() {
	vec2 uv = UV * uv_scale.xy + uv_offset.xy;
	vec3 base = albedo_col.rgb;
	if (has_albedo) base *= texture(albedo_tex, uv).rgb;
	if (use_vcol) base *= COLOR.rgb;
	float rough = roughness;
	if (has_rough) rough = texture(rough_tex, uv).g * roughness;
	vec3 n = normalize(wnrm);
	if (use_detail || damage > 0.0) {
		vec3 w = tri_w(n);
		float lum = dot(base, vec3(0.299, 0.587, 0.114));
		float floor_k = smoothstep(0.62, 0.82, n.y);
		float light_wall = smoothstep(0.24, 0.36, lum);
		vec3 a_wall = mix(tri(rock_a, wpos, w, rock_scale).rgb, tri(brick_a, wpos, w, brick_scale).rgb, light_wall);
		vec3 stone = mix(a_wall, tri(cobble_a, wpos, w, cobble_scale).rgb, floor_k);
		float s_lum = dot(stone, vec3(0.299, 0.587, 0.114));
		if (use_detail) {
			base = mix(base * mix(1.0, s_lum / 0.42, detail), base, 0.3);
			if (!has_normal && detail_normal > 0.0 && length(VERTEX) < 90.0) {   // (near only: 6 extra samples)
				vec3 dn_wall = mix(tri_n(rock_n, wpos, n, w, rock_scale), tri_n(brick_n, wpos, n, w, brick_scale), light_wall);
				vec3 dn = normalize(mix(dn_wall, tri_n(cobble_n, wpos, n, w, cobble_scale), floor_k));
				NORMAL = normalize(mix(NORMAL, (VIEW_MATRIX * vec4(dn, 0.0)).xyz, detail_normal));
			}
		}
		if (damage > 0.0) {
			// cracks: the darkest seams of the stone pattern open up, soot creeps over the piece
			float crack = smoothstep(0.42 - damage * 0.22, 0.30 - damage * 0.2, s_lum);
			base *= mix(1.0, 0.25, crack * damage);
			base *= mix(1.0, 0.62, damage * 0.6);
			rough = 1.0;
		}
	}
	if (has_normal) {
		NORMAL_MAP = texture(normal_tex, uv).rgb;
		NORMAL_MAP_DEPTH = normal_depth;
	}
	ALBEDO = base;
	ROUGHNESS = rough;
	SPECULAR = 0.3;
	EMISSION = emission_col.rgb * emission_col.a * (has_emission_tex ? texture(emission_tex, uv).rgb : vec3(1.0));
}

// THE NEXT-GEN LOOK (Theory 2026-10-23: Zeverland / Animula Nook = "cute figures in a world lit like a real photo"): u13_soft blends
// the cel bands into soft physically lit shading - wrapped diffuse (no hard terminator, no black), a warm subsurface glow just past
// the terminator (plush / skin / petals), energy-normalised specular, a quieter rim. 0 = the cel look, 1 = next-gen (royale/look.gd
// sets it; project.godot [shader_globals] registers it at 0 so every other mode keeps the cel look).
global uniform float u13_soft;

void light() {
	float nl = dot(NORMAL, LIGHT);
	// 3 bands: shade (ambient only) / mid / lit, soft terminator
	float band = smoothstep(terminator - soft, terminator + soft, nl) * band_mid + smoothstep(lit_at - soft, lit_at + soft, nl) * (1.0 - band_mid);
	// soft: wrapped Lambert (light reaches a little round the back), cast shadows deep but never black
	float wrap = clamp((nl + 0.25) / 1.25, 0.0, 1.0);
	float lit = mix(band, wrap, u13_soft);
	float keep = mix(0.45, 0.18, u13_soft);
	DIFFUSE_LIGHT += lit * mix(keep, 1.0, ATTENUATION) * LIGHT_COLOR * ALBEDO / PI * mix(2.0, 1.75, u13_soft);   // (cel: cast shadows keep 45 %: soft TotK shade)
	// subsurface: a warm glow in the band just past the terminator, lit side of the shadow only
	float sss = smoothstep(-0.45, 0.0, nl) * (1.0 - smoothstep(0.0, 0.45, nl));
	DIFFUSE_LIGHT += sss * u13_soft * 0.22 * ALBEDO * vec3(1.0, 0.55, 0.42) * LIGHT_COLOR * mix(0.5, 1.0, ATTENUATION);
	// specular: cel = one crisp band; soft = energy-normalised Blinn-Phong with a Schlick fresnel
	vec3 h = normalize(LIGHT + VIEW);
	float shin = mix(160.0, 12.0, ROUGHNESS);
	float sp = pow(max(dot(NORMAL, h), 0.0), shin);
	float toon = smoothstep(0.5 - soft, 0.5 + soft, sp) * smoothstep(0.75, 0.35, ROUGHNESS) * 0.25;
	float fres = 0.04 + 0.96 * pow(1.0 - max(dot(h, VIEW), 0.0), 5.0);
	float phys = sp * (shin + 8.0) / (8.0 * PI) * fres * max(nl, 0.0) * 0.6;
	SPECULAR_LIGHT += mix(toon, phys, u13_soft) * LIGHT_COLOR * ATTENUATION * step(0.0, nl);
	// rim (lit side): quieter and wider in the soft look (a sheen, not an outline)
	float r = mix(smoothstep(0.62, 0.7, 1.0 - max(dot(NORMAL, VIEW), 0.0)), smoothstep(0.45, 0.9, 1.0 - max(dot(NORMAL, VIEW), 0.0)), u13_soft) * smoothstep(-0.2, 0.3, nl);
	DIFFUSE_LIGHT += r * rim * mix(1.0, 0.45, u13_soft) * mix(vec3(1.0), ALBEDO, rim_tint) * LIGHT_COLOR * ATTENUATION * 0.5;
}
