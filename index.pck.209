Ï·ï/î¦Ìh¡˜üãòJÇz!†æðŸT4ün¬•×«›ncûËr\ÀAºìúûp‡ÝXô‚ÇÖ¯yŸ?([½cvW¤µaœ;6s²ÿET}„k­@ÿÐÈ´“ÃJcèÃÍ¹½$ýáj>Œ>âXüáb<t¹l7ÓÄó¹áýêÉýšèÿvpÛñß™Þ±aþÅh/‡fß7„aäCwJ¸³ÒL7²ÃøÚŸÏ–‰zi␀0[k`0Ý°¬Ž»»P>Ï'¶9@ÿlæ·"¢È?ÛbXÑëôß°êûXøtc‹æ<†Vˆ©û¤@æð[ñ›”Íç&­ý@y­MÏsaÅ\C>/¬ü…ó#Ob”n{Ãn¡?¾µ7:o\O6²†NøÇq@ÂYärX8T‰7¢üóæ]s>Äü!VÎýuz¡~>ÈCfþç„L+ðw»,Éu´ZÈàåH-ý¶Ç„SÓ¸†®@>›×ëß&#ž=¦ú_Áju¤_ñ•_úk|ï$ñxR}"÷]¬'^zpKÚ¯Z›eçkÄ•š:©ñ0­äõàðù±Â^Pã«=L#Ùý*&À¶\í;!šZ›éª‘½_ôc¼·3òªŽ-íýßb[üwÝÏDÀ©\# —,eŽáWÙ^úwö0l€„´’Yš<$ù`îauƒðÙtN␀␀<ùjOÿÂuR+|¨WvÁ„ž[ ¸|æ¦œeñÕÈÿÓNÑö#FÊ¢È:ÓharÐ1UæMø.æö­®{ßåÝã;zþ'fû¬O¸qÍ„ù"A|M¤¿ÝWV±ÂFÂÈÒ,žAž×~€␀ó`°o¨6zJÿbp”ñù±	ÏTÚ,Äã¦c½gvèÇÿ€Ïù)û™ß	Ô%`ï?p>Ý␀N¡t8ð~þéûRH7°	nÓbnsø)/ êŸ>¼…ìY>c=%G\3”G’j1~JÊµ‡YïÙ*:µ®¡‚7k;”9R}>œKùÓÎr¾§…™šÌhâöÃËªdˆ"v¦˜áSü]ÚÃAò¶“É9Í]k¨ÇàôUHúáV£‡ÔX®ëJŸŸ4Ê_ã\¬a;ôèXˆy8Âô7ÃtÄ9Éã6=zŒÀ§¨gåt!`»$lCáÑ)ŸR¾JòIŸMý:„ÝDeºÑðWXA¯¨ç¼Ý>	B¦cFÑ~'³ôK"ÿQ!QîOéŸÏýoÎ¡j ŠÏå—ª»„ñé.Ížù¶û Ý,º-
GIš‘?u7¸ÎO§ú%0?‰ž@ô{½·Z@½ÐëçšÛøë±)ÉˆÔò‰‡¥˜Ø´9ñK»SaòFó(Ó~JÙ—&rñ+¤rá”äó¢\	ÂþL,`B^»YfC¿–ªÍâÙÞ>˜ÝFsIWÁV{]û‘œõa*iWpWâb<¥®Œ‘ªÿ3”WwV{{é¥žØã~.ÞXæló<]ÝD¶×hô8ß/iÓ'Ö¼K|~Ò(ç˜êÌ”×Ð9Bå‰¿Ú\ÔÉpúeiôúóYbH#†Š¿¢÷þvÃç]ßn3ÞÞ©ƒñ¤âÇ«g4âŸ/Ì±‚BÕ]©r×4û²È'‹
ÎØnÑdyºKòýýØØ¯pÑùàŠn þ1„×Ž0:=äü­s±$ùŠØ¸ºžµÑZ\ÆrfF3hyœš—*¾EtÆ“Ä*Š“)ù6t‡Ï`¤‡µÓnNía—_ãö@-üazÑnòŸ˜ílúdQØMÆþÑƒ¹°záÂ½å™WÎ5ªžQÅWÑË(tL}áJýk³t”uà)ƒ‡ÓÞè÷[=î¨x>üÿ‡ºY÷<.;ûônö19w5½×•>µéró!ê¦p¿Ò½xEësQÚÏº©sk_ å§
`·ÙAè+½¾O83Š:àç´¯t>æ›úzG‰Õœõû‚ç¤¾?B<Ó½k}é6Ïu‚üÎ„FMvç¯á;ù»¿øÓÙ¿¯þ$uæóYndö‡y5ÞÌlÚ³RHÀæâgz½z~þO¹ûm­¤ãõ;•Ü‰ú\)km†¼ÀÁÔ·ôÑó!å8è[˜Rèô„»¦M2ùYÄûk;"ð7ôö½qÅÄå␀␀␀␀␀␀␀␀// UNIVERSE 13 Â· POWER ROYALE Â· the island ground, cel-shaded (adapted copy of world/story_map/terrain_cel.gdshader, which blends
// Poly Haven splat textures; the royale island is coloured per vertex by island_terrain.gd color_at, so this one paints that
// colour instead). Same TotK language as the story map: a soft two-tone light band, a cool blue shade (never black), a thin sun
// rim, painted value noise instead of photo detail, and bare strata rock on steep faces. No texture fetches: cheap on the UHD 620.
shader_type spatial;
global uniform float u13_soft;   // the next-gen look (cel_real.gdshader): 0 = two-tone cel, 1 = soft wrapped light + a deeper ground
render_mode cull_back;

uniform vec3 shade_col : source_color = vec3(0.42, 0.50, 0.72);   // the cool TotK shadow
uniform vec3 rock_col : source_color = vec3(0.62, 0.55, 0.50);
uniform vec3 sand_rock_col : source_color = vec3(0.80, 0.50, 0.32); // Shattered Wastes sandstone faces
uniform float band_lo = 0.02;
uniform float band_hi = 0.24;
uniform float rim_k = 0.16;
uniform float paint_k = 0.10;                                       // strength of the painted value noise
// PC build (2026-10-20 cel-shade realism): real ground detail from the Poly Haven sets in assets/materials as LUMINANCE on the
// painted colour (the hue stays the island's), two scales against tiling, rock on steep faces, their normal maps near the camera.
// Off on the web / UHD 620 (look.gd terrain_material only turns it on where the textures are in the build).
uniform bool use_tex = false;
uniform sampler2D grass_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D grass_n : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_n : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float tex_k = 0.55;
// STREETS, per pixel (2026-10-21 map / street readability pass): the 8 m vertex colours blur a 12-24 m street into a grey smear,
// and in Auravex they ran 15 m off the real block grid (towers stood on painted asphalt). Where the vertex colour is one of the city
// greys, the street is drawn here from the same grid the layout packs its blocks on (island_layout.gd _auravex / _clusters):
// asphalt (cool dark) / white kerb / warm sidewalk (3 m, where street_props.gd lines its lamps) / lane dashes / a pale block plaza.
uniform bool streets_on = true;
uniform float world_scale = 1.0;                                   // royale_spec.WORLD_SCALE: every street metre below follows it
uniform vec4 city_rect = vec4(1085.0, 3305.0, -1169.0, 1169.0);   // x0 x1 z0 z1 (island_terrain.gd CITY_RECT), pitch 100
uniform vec2 city_off = vec2(85.0, 31.0);                          // its street centre lines sit at x = 85, z = 31 (mod 100)
uniform vec4 clusters[16];                                          // x, z, r, pitch (street centre lines at multiples of the pitch)
uniform int n_clusters = 0;
uniform vec3 asphalt : source_color = vec3(0.17, 0.19, 0.24);
uniform vec3 kerb : source_color = vec3(0.86, 0.86, 0.84);
uniform vec3 sidewalk : source_color = vec3(0.80, 0.72, 0.58);
uniform vec3 plaza : source_color = vec3(0.60, 0.60, 0.64);
uniform vec3 lane : source_color = vec3(0.98, 0.86, 0.36);
// the Power Storm on the ground for the web build (storm.gd sets these when it has no depth-texture engulf pass)
uniform bool storm_on = false;
uniform vec3 storm_circle = vec3(1900.0, 900.0, 1e6);
uniform vec3 storm_next = vec3(1900.0, 900.0, -1.0);
uniform vec3 storm_gas : source_color = vec3(0.14, 0.58, 0.26);
uniform vec3 storm_glow : source_color = vec3(0.55, 1.0, 0.6);

varying vec3 wpos;
varying vec3 wnorm;

float h21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float vn(vec2 p) {
	vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f);
	return mix(mix(h21(i), h21(i + vec2(1, 0)), f.x), mix(h21(i + vec2(0, 1)), h21(i + vec2(1, 1)), f.x), f.y);
}
vec3 to_linear(vec3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c)); }
float seg_d(vec3 p, vec3 a, vec3 b) { vec3 ab = b - a; return length(p - (a + ab * clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0))); }

// x: how much this vertex colour is a city grey (street <-> block, the plain or the Nightshade palette), y: 1 = Nightshade
vec2 city_mask(vec3 c) {
	float g = seg_d(c, vec3(70.0, 72.0, 82.0) / 255.0, vec3(150.0, 146.0, 152.0) / 255.0);
	float n = seg_d(c, vec3(70.0, 50.0, 96.0) / 255.0, vec3(150.0, 112.0, 182.0) / 255.0);
	return vec2(1.0 - smoothstep(0.035, 0.07, min(g, n)), step(n, g));
}

// the street pattern at x / z for a grid of this pitch (street centre lines at off + k * pitch), half-street w (linear out).
// Every band edge is filtered over one pixel (fwidth) and the fine detail (joints, flags, dashes) fades out as it gets sub-pixel,
// so the pattern cannot shimmer in motion.
vec3 street_col(vec2 p, float pitch, vec2 off, float w, float night) {
	vec2 q = mod(p - off, pitch); q = min(q, pitch - q);          // distance to the nearest centre line, per axis
	float e = w - min(q.x, q.y);                                  // > 0 inside the street band: 0 at the block edge, w at the centre
	float fw = max(fwidth(e), 0.002);
	float fp = max(fwidth(p.x), fwidth(p.y));                     // metres per pixel here
	float fine = 1.0 - smoothstep(0.04, 0.12, fp);
	vec3 a = mix(asphalt, vec3(0.18, 0.13, 0.26), night);
	vec3 s = mix(sidewalk, vec3(0.66, 0.56, 0.78), night);
	vec3 pl = mix(plaza, vec3(0.56, 0.48, 0.66), night);
	vec2 tf = abs(fract(p / (4.0 * world_scale)) - 0.5); vec2 tj = abs(fract(p / (1.5 * world_scale)) - 0.5);
	pl *= 1.0 - 0.06 * fine * step(0.47, max(tf.x, tf.y));          // plaza flags (4 m)
	s *= 1.0 - 0.07 * fine * step(0.46, max(tj.x, tj.y));           // sidewalk joints (1.5 m)
	float side = min(3.0 * world_scale, w * 0.4);
	float kw = 0.35 * world_scale;
	// asphalt, with a dashed yellow centre line along each street (not across the junctions)
	bool along_x = q.y < q.x;                                      // nearer a z centre line: this street runs along x
	float cdist = along_x ? q.y : q.x;
	float other = along_x ? q.x : q.y;
	float dash = step(0.5, fract((along_x ? p.x : p.y) / (6.0 * world_scale))) * (1.0 - smoothstep(0.12 * world_scale - fp, 0.12 * world_scale + fp, cdist)) * step(w + 0.5 * world_scale, other) * fine;
	vec3 road = mix(a, lane, dash);
	vec3 col = mix(pl, s, smoothstep(-fw, fw, e));
	col = mix(col, kerb, smoothstep(side - fw, side + fw, e));
	return mix(col, road, smoothstep(side + kw - fw, side + kw + fw, e));
}

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	// THE GLOW-BLOB FIX (2026-10-23): a terrain vertex with a zero normal made normalize() NaN; SSR / SSAO / bloom smeared that
	// pixel into a white blob with a black core on the ground. Such a vertex now points up.
	if (dot(NORMAL, NORMAL) < 1e-8 || any(isnan(NORMAL))) NORMAL = vec3(0.0, 1.0, 0.0);
	wnorm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 col = to_linear(COLOR.rgb);                                  // island_terrain.gd writes sRGB Color8 values
	// painted brush value: big soft patches + a finer stroke, like TotK's hand-painted fields
	float n = vn(wpos.xz * 0.012) * 0.65 + vn(wpos.xz * 0.07) * 0.35;
	col *= 1.0 + (n - 0.5) * 2.0 * paint_k;
	// steep faces: strata rock (warm sandstone in the Wastes' orange ground, cool grey stone elsewhere)
	float steep = 1.0 - smoothstep(0.55, 0.80, wnorm.y);
	if (steep > 0.01) {
		float warm = smoothstep(0.15, 0.35, col.r - col.b);
		vec3 rc = mix(to_linear(rock_col), to_linear(sand_rock_col), warm);
		float strata = 0.90 + 0.10 * sin(wpos.y * 0.85 + vn(wpos.xz * 0.05) * 3.0);
		col = mix(col, rc * strata, steep * 0.85);
	}
	if (use_tex) {
		vec3 g = texture(grass_a, wpos.xz * 0.11).rgb * 0.6 + texture(grass_a, wpos.xz * 0.017).rgb * 0.4;
		vec3 w = pow(abs(wnorm), vec3(4.0)); w /= (w.x + w.y + w.z);
		vec3 r = texture(rock_a, wpos.zy * 0.07).rgb * w.x + texture(rock_a, wpos.xz * 0.07).rgb * w.y + texture(rock_a, wpos.xy * 0.07).rgb * w.z;
		vec3 t = mix(g, r, steep);
		float l = dot(t, vec3(0.299, 0.587, 0.114)) / max(dot(mix(vec3(0.24, 0.27, 0.16), vec3(0.34), steep), vec3(0.299, 0.587, 0.114)), 0.05);
		col *= mix(1.0, clamp(l, 0.45, 1.6), tex_k);
		if (length(VERTEX) < 120.0) {
			vec3 tn = mix(texture(grass_n, wpos.xz * 0.11).xyz, texture(rock_n, wpos.xz * 0.07).xyz, steep) * 2.0 - 1.0;
			vec3 nw = normalize(wnorm + vec3(tn.x, 0.0, tn.y) * 0.5);
			NORMAL = normalize((VIEW_MATRIX * vec4(nw, 0.0)).xyz);
		}
	}
	if (streets_on) {
		vec2 cm = city_mask(COLOR.rgb);
		vec2 cm2 = city_mask(pow(COLOR.rgb, vec3(1.0 / 2.2)));   // (the Compatibility renderer hands the vertex colour over linear)
		if (cm2.x > cm.x) cm = cm2;
		if (cm.x > 0.0 && wnorm.y > 0.9) {
			vec2 p = wpos.xz;
			float pitch = 0.0; vec2 off = vec2(0.0); float w = 0.0;
			if (p.x >= city_rect.x && p.x <= city_rect.y && p.y >= city_rect.z && p.y <= city_rect.w) { pitch = 100.0 * world_scale; off = city_off; w = 12.0 * world_scale; }
			else {
				for (int i = 0; i < n_clusters; i++) {
					if (length(p - clusters[i].xy) < clusters[i].z) { pitch = clusters[i].w; w = pitch < 80.0 * world_scale ? pitch * 7.0 / 60.0 : pitch * 0.12; break; }
				}
			}
			if (pitch > 0.0) col = mix(col, street_col(p, pitch, off, w, cm.y) * (1.0 + (n - 0.5) * 0.08), cm.x);
		}
	}
	if (storm_on) {   // web build: the storm on the ground (the Forward+ / Mobile engulf pass in storm.gd does this for everything)
		float dc = length(wpos.xz - storm_circle.xy) - storm_circle.z;
		float n2 = vn(wpos.xz * 0.018 + vec2(TIME * 0.05, -TIME * 0.035));
		col = mix(col, mix(storm_gas, storm_glow, n2 * 0.5), smoothstep(0.0, 25.0, dc) * (0.45 + 0.2 * n2));
		float fpx = max(fwidth(wpos.x), 0.05);
		EMISSION = storm_glow * 2.0 * (1.0 - smoothstep(0.0, 1.2 + fpx * 2.0, abs(dc)));
		if (storm_next.z > 0.0) {
			float dn = length(wpos.xz - storm_next.xy) - storm_next.z;
			float dash = step(0.5, fract(atan(wpos.z - storm_next.y, wpos.x - storm_next.x) * storm_next.z / 6.0));
			EMISSION += vec3(0.95) * dash * (1.0 - smoothstep(0.0, 0.8 + fpx * 2.0, abs(dn)));
		}
	}
	if (any(isnan(col)) || any(isinf(col))) col = vec3(0.3);   // (a NaN ground colour blooms into a blob too: never let one out)
	ALBEDO = col * mix(1.0, 0.86, u13_soft);   // (next-gen: the chalky pale ground reads as real paving / soil)
	ROUGHNESS = 0.95;
	SPECULAR = 0.12;
}


void light() {
	float ndl = dot(NORMAL, LIGHT);
	float lit = mix(smoothstep(band_lo, band_hi, ndl) * ATTENUATION, clamp((ndl + 0.25) / 1.25, 0.0, 1.0) * mix(0.15, 1.0, ATTENUATION), u13_soft);
	vec3 shade = shade_col * 0.38;
	DIFFUSE_LIGHT += LIGHT_COLOR * mix(shade, vec3(1.0), lit) / PI;
	float rim = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 4.0) * lit;
	DIFFUSE_LIGHT += LIGHT_COLOR * rim * rim_k / PI;
}
