render_mode cull_disabled;
uniform vec4 tint : source_color = vec4(0.2,0.5,0.3,1.0);
uniform float strength = 1.0;
void vertex() {
 float phase = INSTANCE_CUSTOM.x * 6.283185;
 VERTEX.x += sin(TIME * 0.8 + phase + VERTEX.y * 0.2) * (0.08 * COLOR.r + 0.04 * COLOR.g) * strength;
 VERTEX.z += cos(TIME * 2.3 + phase) * 0.04 * COLOR.b * strength;
}
void fragment() { ALBEDO=tint.rgb; ROUGHNESS=0.85; }
