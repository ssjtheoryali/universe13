          "camera": "Emotional close-up / held reaction",
          "action": "ALI: He's still trying to help. ROSE: Then we help him.",
          "performance_note": "Noki: restraint, distress, brief recognition; Ali: resolve; Rose: empathy; Juevy: worried trust; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
