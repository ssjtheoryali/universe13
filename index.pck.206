        "source_legacy_anchors": [
          "chapter_14"
        ],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS28",
      "sequence": 28,
      "title": "The Name Behind the Damage",
      "locations": [
        "Ultimate HQ",
        "abandoned workstation"
      ],
      "opening": "Only now do we see and hear Chibi Pixel in his canon in-game model.",
      "objective": "Assemble main-route proof. Show present commands, not an origin flashback.",
      "outcome": "He plans planet erasure and obedient reprogrammed worlds. His lost world and the legendary evil behind it remain secret for his later background story.",
      "map_records": [
        "chapter_15"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_15"
      ],
      "realm": "CHIBI / HQ Revelation",
      "character_turn": "Terra recognises her brother. He caused the Calamity by extracting particles through rifts.",
      "dialogue": "Terra: That's my brother. And this is his choice.",
      "expression_cues": "Terra: betrayal; Ali: concern; Pixel: certainty",
      "party_event": "reveal:Pixel",
      "chapter": 6,
      "chapter_title": "Order Without Consent",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS28_A",
          "sequence": "MS28",
          "cut_id": "MS28_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Only now do we see and hear Chibi Pixel in his canon in-game model.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS28_B",
          "sequence": "MS28",
          "cut_id": "MS28_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Terra recognises her brother. He caused the Calamity by extracting particles through rifts.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS28_C",
          "sequence": "MS28",
          "cut_id": "MS28_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Terra: That's my brother. And this is his choice.",
          "performance_note": "Terra: betrayal; Ali: concern; Pixel: certainty; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS28_D",
          "sequence": "MS28",
          "cut_id": "MS28_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Assemble main-route proof. Show present commands, not an origin flashback.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS28_E",
          "sequence": "MS28",
          "cut_id": "MS28_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "He plans planet erasure and obedient reprogrammed worlds. His lost world and the legendary evil behind it remain secret for his later background story.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS28_F",
          "sequence": "MS28",
          "cut_id": "MS28_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: reveal:Pixel. Carry the eyeline into Order Without Consent.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. SEALED WORKSTATION - NIGHT. The recovered records assemble into a present command. A display opens. FIRST REVEAL: canon in-game Chibi Season 1 Pixel, exact approved face and costume. Never substitute the all-purple Season 2 model."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "Stop interfering with the return.",
          "line_id": "MS28_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "You mean the extraction.",
          "line_id": "MS28_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "I mean order.",
          "line_id": "MS28_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "The return to a functional state. Your preferred word changes nothing.",
          "line_id": "MS28_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Terra's fingers close around her tool and then loosen. She sets it down before speaking. She will not approach this as another mechanism she can repair."
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Terra steps into the display's light. Hold her eyes before his reaction. No origin flashback, destroyed homeland, legendary enemy clue or excuse is introduced."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "Pixel.",
          "line_id": "MS28_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "Terra. You should have contacted me.",
          "line_id": "MS28_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I have been helping people.",
          "line_id": "MS28_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "So have I. Terra. Move away from them.",
          "line_id": "MS28_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You know him? Terra. Who is he?",
          "line_id": "MS28_IN_D09"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "He is my brother.",
          "line_id": "MS28_IN_D10"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali's first glance is toward the route behind her, checking whether she has space to step back. He does not turn a revelation into an interrogation."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Assemble the main-route proof on separate displays: stolen particles, erased addresses, imposed commands. Pixel's active system labels living worlds as editable resources. Keep the information specific to his current operation."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "Look at the settlements you have left. Every repair vulnerable to another failure. Every decision another fault.",
          "line_id": "MS28_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Those are not faults. They are people making decisions.",
          "line_id": "MS28_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "Decisions have consequences. I intend to remove the worst of them.",
          "line_id": "MS28_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "By removing the people who do not fit?",
          "line_id": "MS28_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "By correcting the conditions that produce them.",
          "line_id": "MS28_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Pixel keeps the reconstruction pristine while the real extraction records scroll beside it. His refusal to look at a suffering individual is a choice, not ignorance."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "No more broken worlds. No more waste.",
          "line_id": "MS28_BRIDGE_D06"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "No choice.",
          "line_id": "MS28_BRIDGE_D07"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "You are taking planets apart to make them obey you.",
          "line_id": "MS28_BRIDGE_D08"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "I am giving them a purpose.",
          "line_id": "MS28_BRIDGE_D09"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "They already have lives.",
          "line_id": "MS28_BRIDGE_D10"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Show us one person who asked you for this.",
          "line_id": "MS28_BRIDGE_D11"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "You of all people should understand the value of preventing a failure.",
          "line_id": "MS28_BRIDGE_D12"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "I understand checking a repair. I do not understand calling someone else's life a mistake.",
          "line_id": "MS28_BRIDGE_D13"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Pixel shows a clean, rigid reconstruction with every inhabitant moving on command."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PIXEL",
          "text": "Come here. We can discuss this without them.",
          "line_id": "MS28_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "You mean where nobody can disagree with you.",
          "line_id": "MS28_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PIXEL",
          "text": "I am offering you a safe place.",
          "line_id": "MS28_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "I found one. We argue in it.",
          "line_id": "MS28_OUT_D04"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Her voice shakes after the refusal, not before it. Pixel sees the tremor and mistakes it for a weakness he can correct."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PIXEL",
          "text": "You are frightened.",
          "line_id": "MS28_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Yes. I am still staying.",
          "line_id": "MS28_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "He ends the connection. The crew leaves her the silence to breathe in."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Pixel terminates the call and escalates extraction. Terra remains with the party by explicit choice. The sibling reveal does not make the crew distrust her by default."
        }
      ],
      "visual_direction": {
        "palette": "Workstation sterile geometry / Terra warm edge",
        "framing": "First show canon Pixel only now; hold Terra before the sibling line.",
        "sound": "Present commands only; no origin-memory sound."
      },
      "baseline_shot_ids": [
        "MS28_A",
