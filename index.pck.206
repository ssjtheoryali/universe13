      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS26",
      "sequence": 26,
      "title": "A Sanctuary Freely Held",
      "locations": [
        "Lumen Sanctuary",
        "Queen Bower",
        "Edge Wish"
      ],
      "opening": "The Chibi Queen shields the bower as realistic Rose arrives with volunteers.",
      "objective": "Break sanctuary chain; protect Queen Bower and Edge Wish; finish fragment returns.",
      "outcome": "The sanctuary becomes a return anchor. The ally can rejoin after the emergency.",
      "map_records": [
        "chapter_13"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_13"
      ],
      "realm": "CHIBI / Lumen Chain",
      "character_turn": "They share an eyeline, not a body or history. An ally chooses local duty.",
      "dialogue": "Queen: Help is a choice. Keep it one.",
      "expression_cues": "Queen and Rose: respect; Ali: trust",
      "party_event": "temporary_leave:local_support",
      "chapter": 6,
      "chapter_title": "Order Without Consent",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS26_A",
          "sequence": "MS26",
          "cut_id": "MS26_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "The Chibi Queen shields the bower as realistic Rose arrives with volunteers.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS26_B",
          "sequence": "MS26",
          "cut_id": "MS26_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "They share an eyeline, not a body or history. An ally chooses local duty.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS26_C",
          "sequence": "MS26",
          "cut_id": "MS26_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Queen: Help is a choice. Keep it one.",
          "performance_note": "Queen and Rose: respect; Ali: trust; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS26_D",
          "sequence": "MS26",
          "cut_id": "MS26_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Break sanctuary chain; protect Queen Bower and Edge Wish; finish fragment returns.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS26_E",
          "sequence": "MS26",
          "cut_id": "MS26_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The sanctuary becomes a return anchor. The ally can rejoin after the emergency.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
