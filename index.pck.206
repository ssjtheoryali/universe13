          "action": "Patch joins after the last den is safe. Hold an ordinary happy moment with Terra.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS18_F",
          "sequence": "MS18",
          "cut_id": "MS18_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Patch. Carry the eyeline into Quad Blocks the Crossing.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. FOREST DEN ROUTE - AFTERNOON. Patch blocks a damaged den entrance while living limbs shift between settlements. Terra spots a creature trying to drag a blanket back inside."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PATCH",
          "text": "Do not pull that thread.",
          "line_id": "MS18_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I was not--",
          "line_id": "MS18_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PATCH",
          "text": "Everybody says that with the thread in their hand.",
          "line_id": "MS18_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Patch catches the frayed blanket and turns it so the creature can keep the familiar side against its body. Terra gives an approving little nod. They understand the task before explaining it."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "We move the nest smell with the nest.",
          "line_id": "MS18_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PATCH",
          "text": "Exactly. Somebody finally speaks blanket.",
          "line_id": "MS18_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PATCH",
          "text": "It will not leave its place.",
          "line_id": "MS18_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "Then we bring its place out with it.",
          "line_id": "MS18_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Terra folds the blanket around the frightened creature without forcing contact. Ali keeps his large hands still until Patch signals. Hold an unhurried kindness before the traversal."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Restore the limb routes through the base, Millbrook, Elder Grove, Ranger Hut, dens and old gate. Visit the assigned hidden-base location during the main route but do not trigger its hidden-quest completion as a gate. Patch joins after the final den is safe."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "At the living branch junction Patch waits for the forest's knock before stepping. Ali tries knocking back. Three routes answer."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Was that good?",
          "line_id": "MS18_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PATCH",
          "text": "That was several questions you do not know how to ask.",
          "line_id": "MS18_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "A historic first for him.",
          "line_id": "MS18_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Patch lays a hand on the bark and waits. They follow formed wood and flowering vines; no new plank bridge or rope rail replaces the living architecture."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The crew shares a short rest on a steady limb. Terra gives Ali a leaf shaped like a tiny chair."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "For your enormous collection of small cups.",
          "line_id": "MS18_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "I have one cup.",
          "line_id": "MS18_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Every collection starts somewhere.",
          "line_id": "MS18_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Keep it. It suits your headquarters.",
          "line_id": "MS18_OUT_D04"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Terra offers Ali the leaf chair for his small cup. He starts the old enormous-collection joke, then notices she has repaired the same seam in her wrap three times."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You can leave that one for somebody else.",
          "line_id": "MS18_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "It catches when I work.",
          "line_id": "MS18_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PATCH",
          "text": "Then stop stitching it while you are wearing it.",
          "line_id": "MS18_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Patch holds out a hand. Terra hesitates, then slips the wrap free. For once she is the person being looked after."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "There. Nobody collapsed.",
          "line_id": "MS18_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Give it a minute.",
          "line_id": "MS18_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "They laugh. No sad music tells the audience how to remember this."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Ali tucks it beside the home marker. Terra laughs through eyes and shoulders. This ordinary happy beat becomes memory later; do not foreshadow her loss with ominous dialogue."
        }
      ],
      "visual_direction": {
        "palette": "Bright forest rest / gentle leaf bounce",
        "framing": "Small cup and leaf chair are ordinary, not prophetic inserts.",
        "sound": "Relaxed chatter and den sounds; no warning sting."
      },
      "baseline_shot_ids": [
        "MS18_A",
        "MS18_B",
        "MS18_C",
        "MS18_D",
        "MS18_E",
        "MS18_F"
      ],
