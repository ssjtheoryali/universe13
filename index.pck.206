          "source": "story_map_data.gd",
          "section": "WOODS"
        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Sea Arch",
      "character_turn": "Ali and Rose identify the signature of their own reality beyond the Sea Arch. These are distinct universes; they need the correct return address, not any open portal.",
      "dialogue": "Ali: Different doesn't mean less real.",
      "expression_cues": "Ali and Rose: awe to understanding",
      "party_event": "none",
      "chapter": 4,
      "chapter_title": "Different Roads Home",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS16_A",
          "sequence": "MS16",
          "cut_id": "MS16_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "A tracking shot crosses Sea Arch West into a different coastline with incompatible signatures.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS16_B",
          "sequence": "MS16",
          "cut_id": "MS16_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Ali and Rose identify the signature of their own reality beyond the Sea Arch. These are distinct universes; they need the correct return address, not any open portal.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS16_C",
          "sequence": "MS16",
          "cut_id": "MS16_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Different doesn't mean less real.",
          "performance_note": "Ali and Rose: awe to understanding; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS16_D",
          "sequence": "MS16",
          "cut_id": "MS16_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Restore Lagoon Shrine and Overpass 13; escort travellers and tag universe-of-origin coordinates.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS16_E",
          "sequence": "MS16",
          "cut_id": "MS16_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The expedition names the multiverse. Repair will preserve distinct worlds.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS16_F",
          "sequence": "MS16",
          "cut_id": "MS16_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into The Valley of Possible Lives.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. SEA ARCH WEST - LATE DAY. The camera travels through the arch without cutting. On the far side, the coastline's materials and sky obey a different pattern. The geography joins, but the origin signatures do not."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "That sky was not there a second ago.",
          "line_id": "MS16_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "The sky was there. Beside this coast was the part that changed.",
          "line_id": "MS16_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "I preferred the short frightening version.",
          "line_id": "MS16_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Rose studies overlapping coordinates. She keeps trying to force them onto one diagram, scrubbing a line out so hard it tears the paper."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Hey. Scanner not taking notes?",
          "line_id": "MS16_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "It is. I am trying to understand them.",
          "line_id": "MS16_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "We crossed a bridge. Why does the sky feel farther away?",
          "line_id": "MS16_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Because this coast did not start beside that one.",
          "line_id": "MS16_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "The rift put neighbours where there were none.",
          "line_id": "MS16_IN_D08"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Rose overlays three recorded addresses. They occupy distinct world systems, not regions of one globe. Do not turn this revelation into an omniscient lecture about unseen universes."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Restore Lagoon Shrine and Overpass 13, escort local travellers and attach the correct universe-of-origin tags. A particle nearly enters the wrong anchor; Ali stops it until Rose verifies the address. The correct return restores a distant feature in its own sky."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Terra places the two torn pieces beside each other without joining them. A particle aligns to the wrong coast; Rose stops the return before anyone touches the control."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Different origins. We keep drawing a bigger map when we need more than one.",
          "line_id": "MS16_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Whole different universes?",
          "line_id": "MS16_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Yes.",
          "line_id": "MS16_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Could you have started with that?",
          "line_id": "MS16_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "I wanted to be sure before I said it out loud.",
          "line_id": "MS16_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The crew watches two stable horizons through one repaired crossing."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "More than one universe.",
          "line_id": "MS16_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "A multiverse.",
          "line_id": "MS16_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Then finding your home means learning which world is yours.",
          "line_id": "MS16_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "And not taking someone else's place to get there.",
          "line_id": "MS16_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "If there is a place exactly like ours--",
          "line_id": "MS16_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "It would have somebody exactly like us missing from it.",
          "line_id": "MS16_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "He considers the convenience he had nearly mistaken for rescue."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You thought about it too.",
          "line_id": "MS16_OUT_D07"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "For a second.",
          "line_id": "MS16_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Okay.",
          "line_id": "MS16_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Neither judges the other's desire to take the easy way. They both leave that path unchosen."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Save the distinction between local route and origin reality. Travel toward Prism with a clear new rule: repair must preserve each world's identity."
        }
      ],
      "visual_direction": {
        "palette": "Distinct coast skylights",
        "framing": "Travel through the arch without a concealing location cut.",
        "sound": "Separate coast ambiences meet without becoming one mix."
      },
      "baseline_shot_ids": [
        "MS16_A",
        "MS16_B",
        "MS16_C",
        "MS16_D",
        "MS16_E",
        "MS16_F"
      ],
      "gameplay_entry": {
        "cut": "MS16_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
