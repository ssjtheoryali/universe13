      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS22",
      "sequence": 22,
      "title": "The Show That Stole Colour",
      "locations": [
        "Inkwell",
        "Encore City"
      ],
      "opening": "Mister Smiles performs to empty seats while Encore City loses colour.",
