          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS37_C",
          "sequence": "MS37",
          "cut_id": "MS37_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: I can hear you without becoming you.",
          "performance_note": "Ali: empathy; Dealer: recognition; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS37_D",
          "sequence": "MS37",
          "cut_id": "MS37_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Complete Dealer duel; keep Hellcat's relic and Spirit Step gates separate from core count.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS37_E",
          "sequence": "MS37",
          "cut_id": "MS37_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Recognition replaces rivalry without replacing anyone's life.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS37_F",
          "sequence": "MS37",
          "cut_id": "MS37_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: unlock:Hellcat_Ali. Carry the eyeline into Every World Sends Something Home.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. DEALER CROSSING - LATE DAY. Dealer mirrors Ali's ready stance. Their similarity is a provocation, but the route scanner records a different history."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "DEALER",
          "text": "Every step you know, I knew first.",
          "line_id": "MS37_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You can have the first one.",
          "line_id": "MS37_IN_D02"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali does not rise to the familiar provocation. Dealer moves, expecting the mirrored response. Ali instead waits for Rose to clear the line of danger."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "DEALER",
          "text": "You have got slower.",
          "line_id": "MS37_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I have got people to look at.",
          "line_id": "MS37_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "DEALER",
          "text": "You think you know me?",
          "line_id": "MS37_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I know that move.",
          "line_id": "MS37_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "DEALER",
          "text": "That is not the same thing.",
          "line_id": "MS37_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Echo the MS33 matching pose for a moment, then break the symmetry. This encounter tests recognition of difference, not another copy joke."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Complete Dealer's duel through the source route. Keep Hellcat's relic and Spirit Step requirements distinct from six-core progress. When the duel ends, Ali lowers his guard only after Dealer does. Do not assume a permanent recruitment, death or redemption beyond the verified unlock state."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Dealer attacks the old rhythm: confidence, answer, escalation. Ali begins to follow it, then catches the rescue clip against his chest and breaks the pattern. His developing restraint has a physical interruption, not an announced new philosophy."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "DEALER",
          "text": "Hesitating?",
          "line_id": "MS37_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Choosing.",
          "line_id": "MS37_BRIDGE_D02"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Complete the actual duel without making Dealer's separate history a lesson invented solely for Ali. When the opening comes, Ali takes the earned win and leaves room for Dealer to lower his own guard."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The road opens. Ali sees another life without trying to overwrite it with his own."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You're right. It is not.",
          "line_id": "MS37_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Ready?",
          "line_id": "MS37_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Ready to finish the way home.",
          "line_id": "MS37_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "DEALER",
          "text": "Think that makes you different?",
          "line_id": "MS37_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "I do not know what made you.",
          "line_id": "MS37_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Ali means the limitation. He does not claim the right to explain another person because they share a move."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "I know who came with me.",
          "line_id": "MS37_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "And who is still waiting.",
          "line_id": "MS37_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "They leave without a victory quip. The next task is returning what survived, not winning another argument."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Register Hellcat Ali only if its actual gates are met. Carry earned support forward; the finale remains possible without optional side or hidden quests."
        }
      ],
      "visual_direction": {
        "palette": "Late-day duel / asymmetric figures",
        "framing": "Begin mirrored pose then break it to distinguish histories.",
        "sound": "Distinct movement rhythms; no copy gag sting."
      },
