          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS40_F",
          "sequence": "MS40",
          "cut_id": "MS40_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: home:Ali,Ivy. Hold the homecoming; leave stable chosen gates as the postgame state.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. RESTORED CHIBI ROUTE - MORNING. Revisit markets, water, sanctuary and Noki's district in the same compositions used during damage. Their occupants resume ordinary roles. Noki steadies a crossing for a small traveller and a native creature; the gesture is calm again."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "He is back to stopping the whole crossing for a nest.",
          "line_id": "MS40_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Noki?",
          "line_id": "MS40_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "No, you. You have been standing there watching him for five minutes.",
          "line_id": "MS40_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Noki waits calmly for a creature below the bridge. Ali smiles through shoulders and eyes. Peace has a mildly inconvenient rhythm again."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Still keeping the peace.",
          "line_id": "MS40_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Mostly?",
          "line_id": "MS40_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Mostly.",
          "line_id": "MS40_IN_D06"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "The party reaches the deliberate gate without reopening uncontrolled rifts. Say farewell to the actual earned companions; use role-based alternate inserts for others. Terra's empty seat and keepsake remain in the Chibi world beside the listening channel. No present-day Terra joins the farewell."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "I checked your route.",
          "line_id": "MS40_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "REAL ALI",
          "text": "You worried about me?",
          "line_id": "MS40_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "About my reputation. There are apparently two of us making decisions now.",
          "line_id": "MS40_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "We are keeping the records separate.",
          "line_id": "MS40_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "Good. His jumping is not on me.",
          "line_id": "MS40_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "They land the fist bump at the agreed height without missing. Juevy then struggles to find an ordinary way to say goodbye."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "Try not to get lost without me.",
          "line_id": "MS40_BRIDGE_D06"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "REAL ALI",
          "text": "Try not to take all my good lines.",
          "line_id": "MS40_BRIDGE_D07"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "I had a whole clever thing.",
          "line_id": "MS40_BRIDGE_D08"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Take a minute.",
          "line_id": "MS40_BRIDGE_D09"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "That is the problem. You finally learned to wait, and now you are leaving.",
          "line_id": "MS40_BRIDGE_D10"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Ali crouches to the actual shared eye line. He does not repeat a promise that cannot guarantee a date."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "You will answer the channel?",
          "line_id": "MS40_BRIDGE_D11"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "Unless Tres is telling the kicking story.",
          "line_id": "MS40_BRIDGE_D12"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Give you a minute.",
          "line_id": "MS40_BRIDGE_D13"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "EXT. ALI AND ROSE'S REALITY - DAY. They step onto their own street. Rose checks both origin readings before lowering the scanner. They remain realistic; no Chibi friend becomes a human counterpart."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Same address. Same sky.",
          "line_id": "MS40_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Same us.",
          "line_id": "MS40_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "With a way back.",
          "line_id": "MS40_OUT_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The final verification is complete. Rose turns the scanner completely off. The action frightens her a little. She does it anyway. Ali unclips the cup and sets it on a perfectly ordinary surface."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "There. Boring.",
          "line_id": "MS40_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "It is a good spot.",
          "line_id": "MS40_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Neither says everything is the same. Ali starts to walk ahead, stops, and waits. Rose takes the step beside him."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "No plan for a minute?",
          "line_id": "MS40_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "One minute.",
          "line_id": "MS40_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Behind them the safe gate holds its chosen address. In the Chibi world, their friends return to their own routines. The empty seat remains; the open receiver is cared for by people who have work, jokes, disagreements and tomorrow."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Through the safe chosen gate, the Chibi friends return to their own lives. Ali and Rose take a step together toward home. End Season 1 on that resolved return. Postgame can offer controlled revisits; manga Juevy and Pixel's hidden background remain for later stories, without a Season 1 reveal."
        }
      ],
      "visual_direction": {
        "palette": "Natural home daylight / restored local warmth",
        "framing": "Same street axis and a first-try fist bump; two worlds stay distinct.",
        "sound": "Controlled gate closes gently; no cliffhanger villain voice."
      },
      "baseline_shot_ids": [
        "MS40_A",
        "MS40_B",
        "MS40_C",
        "MS40_D",
        "MS40_E",
        "MS40_F"
      ],
      "gameplay_entry": {
        "cut": "MS40_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
      "gameplay_exit": {
        "cut": "MS40_OUT",
        "requires": "MS40_objective_complete",
        "quest_flag_is_proposed_binding": true,
        "source_legacy_anchors": [],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    }
  ]
