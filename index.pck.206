        },
        {
          "shot_id": "MS38_E",
          "sequence": "MS38",
          "cut_id": "MS38_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Six complete cores stand ready. The stopped network returns what it consumed.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS38_F",
          "sequence": "MS38",
          "cut_id": "MS38_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: party:all_earned_support. Carry the eyeline into The Wish That Leaves Worlds Free.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. CONNECTED RETURN ANCHOR - DAWN. Giant Noki braces the homeward structure with the same open hand seen before the Calamity. Established local friends arrive from their working routes, bringing the pieces earned throughout the main story."
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Nobody announces an assembly of heroes. The established Chibi crew arrives tired from useful jobs. A supply wheel sticks; a scanner needs a clean contact; somebody is hungry. Noki lowers his hand for a traveller before turning to the great anchor."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "BUN BUN, IF EARNED",
          "text": "Where do these go?",
          "line_id": "MS38_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SAKURA POP, IF EARNED",
          "text": "Where people can reach them. We learned that one.",
          "line_id": "MS38_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROCKET, IF EARNED",
          "text": "I put them on the high shelf once.",
          "line_id": "MS38_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "BUN BUN, IF EARNED",
          "text": "We all remember.",
          "line_id": "MS38_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Road is open.",
          "line_id": "MS38_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "Addresses agree.",
          "line_id": "MS38_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Then let us send everything where it belongs.",
          "line_id": "MS38_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Each present ally contributes their own job. Show absent field recruits as remote support only if earned. Quad never appears among helpers; Terra's seat remains empty."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Complete the connected particle returns and anchor checks using the already visited main-route POIs. Montage the actual recovered landmarks, matching earlier damaged views. No new human errands or side/hidden quest completion gates are added. Every family fills from its recorded fragments; verify origin tags before assembly."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Rose starts to walk the address check alone. She stops and gives half the ledger to Theory. Ali takes the other side of the route with Juevy. Terra's former task is shared by two established support roles; nobody silently becomes a replacement Terra."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "THEORY",
          "text": "Your verification order?",
          "line_id": "MS38_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Yours first. Mine after. We compare.",
          "line_id": "MS38_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "THEORY",
          "text": "That will take longer.",
          "line_id": "MS38_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "We have people in the other case.",
          "line_id": "MS38_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Theory recognizes his own words from MS11. He does not need to smile for the trust to register."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Six complete cores stand ready. Ali places his home marker beside Rose's, then leaves Terra's keepsake with the open receiver."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "We brought back what we could find.",
          "line_id": "MS38_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "We keep the way open for what is still missing.",
          "line_id": "MS38_OUT_D02"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Ali takes the small cup from his travel clip. He nearly puts it on Terra's empty chair, then changes his mind and sets it beside his home marker. It is a gift to carry, not property that must be buried with her absence."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "JUEVY",
          "text": "Boring enough?",
          "line_id": "MS38_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Working on it.",
          "line_id": "MS38_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "NOKI",
          "text": "Hand ready.",
          "line_id": "MS38_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "His great open palm steadies the route while the crew finishes its smaller jobs."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "The empty place remains visible without a supernatural answer. Noki's supporting hand and the six cores lead into alignment."
        }
      ],
      "visual_direction": {
        "palette": "Dawn anchors / six measured colours",
        "framing": "Each earned local role contributes; Noki supports at world scale.",
        "sound": "Regional response calls identify distinct origins."
      },
      "baseline_shot_ids": [
        "MS38_A",
        "MS38_B",
        "MS38_C",
        "MS38_D",
        "MS38_E",
        "MS38_F"
      ],
      "gameplay_entry": {
        "cut": "MS38_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
