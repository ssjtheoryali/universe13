      "opening": "Prism Sentinel overlays perfect valleys. Shard holds an evacuation path.",
      "objective": "Cleanse Sentinel; recover Prism fragments and Lens; beat Glass Hydra; free the local Queen and help Shard.",
      "outcome": "One living valley replaces false reflections. Shard and Queen can join; neither is realistic Rose.",
      "map_records": [
        "room_crystalroom",
        "wt_crystal_ridge"
      ],
      "additional_records": [
        {
          "id": "crystal_monument",
          "name": "THE CRYSTAL MONUMENT",
