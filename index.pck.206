          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS12_F",
          "sequence": "MS12",
          "cut_id": "MS12_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Sakura_Pop,Bun_Bun,Rocket. Carry the eyeline into The Fire That Would Not End.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. STATIC CROSSING - MORNING. Sakura Pop directs a stalled group, Bun Bun steadies supplies, and Rocket tests the next stretch of road. Their ordinary jobs are the reason the route has survived."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROCKET",
          "text": "Good news. There is a landing.",
          "line_id": "MS12_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "BUN BUN",
          "text": "That is not news. That is half a bridge.",
          "line_id": "MS12_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROCKET",
          "text": "The useful half.",
          "line_id": "MS12_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SAKURA POP",
          "text": "Both of you. We are moving the supplies before we move your argument.",
          "line_id": "MS12_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Sakura Pop uses a bright voice to hold the group together. When a frightened traveller turns away, her voice drops to a private, practical register instead of getting louder."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SAKURA POP",
          "text": "You only need the first step. Stay beside me.",
          "line_id": "MS12_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROCKET",
          "text": "This way is passable.",
          "line_id": "MS12_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "BUN BUN",
          "text": "Your definition of passable has a running start.",
          "line_id": "MS12_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SAKURA POP",
          "text": "Everyone gets across. Then you can argue about style.",
          "line_id": "MS12_IN_D08"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali waits for the locals' plan rather than assuming command. Rose checks their route against her home trace."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Reconnect Static Crossing, Brightwater, Juevy Junction, Critter Lake, the residential roads, Wilds and cliffs. Give each recruit an indispensable local action: organizing the crossing, moving the load, scouting the landing. Thread the same returning supply caravan through the stops to make the many POIs one journey."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Rocket starts ahead. Bun Bun refuses to move the cart until the wheels are secured. Ali begins to side with speed, then sees Rocket come back and test the load without being asked."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "I thought you liked the running start.",
          "line_id": "MS12_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROCKET",
          "text": "I like landing with the things I left with.",
          "line_id": "MS12_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "BUN BUN",
          "text": "Write that down. He said a sensible thing.",
          "line_id": "MS12_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "SAKURA POP",
          "text": "Later. We need him encouraged.",
          "line_id": "MS12_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Their bickering is established cooperation, not random hostility. Each knows the task the other will catch."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "At the fork, the three volunteers choose between travel and keeping the road open. The player decides who accompanies the field party; all retain purposeful work."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You do not have to leave your people for us.",
          "line_id": "MS12_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "SAKURA POP",
          "text": "Helping the road helps our people.",
          "line_id": "MS12_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Then we keep it open in both directions.",
          "line_id": "MS12_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "BUN BUN",
          "text": "If I stay with the road, you do not get to call it sitting this one out.",
          "line_id": "MS12_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "I have been corrected on that.",
          "line_id": "MS12_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "SAKURA POP",
          "text": "Good. Saves time.",
          "line_id": "MS12_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROCKET",
          "text": "Who is coming?",
          "line_id": "MS12_OUT_D07"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Whoever chooses to. We still need this place when we come back.",
          "line_id": "MS12_OUT_D08"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Sakura checks the people before she checks the route. Rocket waits for Bun Bun's signal, pretending not to wait."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Register earned recruits. Show the unselected volunteers moving supplies behind the departing party, not fading out of the story."
        }
      ],
      "visual_direction": {
        "palette": "Open daylight / regional colour changes",
        "framing": "Track one caravan through all connected recruitment stops.",
        "sound": "Distinct footfalls and cart rhythm, not a lyric montage."
      },
      "baseline_shot_ids": [
        "MS12_A",
        "MS12_B",
        "MS12_C",
        "MS12_D",
        "MS12_E",
        "MS12_F"
      ],
      "gameplay_entry": {
