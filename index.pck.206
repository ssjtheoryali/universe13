      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS37",
      "sequence": 37,
      "title": "The Life Behind the Other Mask",
      "locations": [
        "Reality Room",
        "Mirror Hall",
        "counterpart crossing"
      ],
      "opening": "Dealer mirrors Ali's moves but carries a separate history.",
      "objective": "Complete Dealer duel; keep Hellcat's relic and Spirit Step gates separate from core count.",
      "outcome": "Recognition replaces rivalry without replacing anyone's life.",
      "map_records": [],
      "additional_records": [],
      "legacy_anchors": [],
      "realm": "CHIBI / Dealer Duel",
      "character_turn": "Ali listens before the last exchange; shared assets do not settle unapproved identities.",
      "dialogue": "Ali: I can hear you without becoming you.",
      "expression_cues": "Ali: empathy; Dealer: recognition",
      "party_event": "unlock:Hellcat_Ali",
      "chapter": 8,
      "chapter_title": "Home, With a Way Back",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS37_A",
          "sequence": "MS37",
