    },
    {
      "id": "MS07",
      "sequence": 7,
      "title": "The Masked Rose",
      "locations": [
        "Glitch Gardens",
        "Rustwater"
      ],
      "opening": "Realistic Ivy arrives in the exact Higgsfield ivyrosemasked stealth-mask look.",
      "objective": "Protect Glitch Gardens and Rustwater; compare displaced particles.",
      "outcome": "Ali and Rose reunite. Their shared goal is getting back to their own reality; Chibi allies help repair the route that makes that possible.",
      "map_records": [
        "glitch_gardens",
        "rustwater",
        "save_glitch_gardens",
        "save_rustwater",
