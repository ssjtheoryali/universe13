    {
      "id": "MS20",
      "sequence": 20,
      "title": "Mirrors Are Not Replacements",
      "locations": [
        "Hollowmere",
        "Mirror Lake",
        "Mirrorwood",
        "Mirror Shrine",
        "Mirror Run",
        "Northwind Crag",
        "Northwind Pines",
        "Cloudbreak Peak",
        "Crag Ruins",
        "North Shore"
      ],
      "opening": "Ali's reflection moves late; Chibi Ali glimpsed across the lake has his own life.",
      "objective": "Restore Hollowmere, Mirror Shrine, crag, caves, north shore and cloudbreak; escort residents home.",
      "outcome": "Ali rejects swapping lives. The support ally returns after local repairs.",
      "map_records": [
        "hollowmere",
        "save_hollowmere",
        "post_hollowmere",
        "wt_north_shore",
        "shrine_mirror",
        "cave_northwind",
