        },
        {
          "shot_id": "MS10_D",
          "sequence": "MS10",
          "cut_id": "MS10_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Use the remembered peacekeeping gesture to reach safe zones, quiet the corrupt pulse and recover the next homeward signal. Preserve Noki and the sparse local Chibi residents; do not kill the guardian.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
