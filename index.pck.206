      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_05"
      ],
      "realm": "CHIBI / Glitch Gardens",
      "character_turn": "Ali recognises her voice before she lowers her weapon. Neither becomes a Chibi model.",
      "dialogue": "Rose: Same way home. More people to get there safely.",
      "expression_cues": "Ali: recognition and relief; Rose: guarded relief",
      "party_event": "join:Ivy",
      "chapter": 2,
      "chapter_title": "The Masked Rose",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS07_A",
          "sequence": "MS07",
          "cut_id": "MS07_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Realistic Ivy arrives in the exact Higgsfield ivyrosemasked stealth-mask look.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS07_B",
          "sequence": "MS07",
          "cut_id": "MS07_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Ali recognises her voice before she lowers her weapon. Neither becomes a Chibi model.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS07_C",
          "sequence": "MS07",
          "cut_id": "MS07_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Rose: Same way home. More people to get there safely.",
          "performance_note": "Ali: recognition and relief; Rose: guarded relief; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS07_D",
          "sequence": "MS07",
          "cut_id": "MS07_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Protect Glitch Gardens and Rustwater; compare displaced particles.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS07_E",
          "sequence": "MS07",
          "cut_id": "MS07_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Ali and Rose reunite. Their shared goal is getting back to their own reality; Chibi allies help repair the route that makes that possible.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS07_F",
          "sequence": "MS07",
          "cut_id": "MS07_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Ivy. Carry the eyeline into The Sanctuary's Missing Light.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. GLITCH GARDENS - DAY. Masked realistic Rose holds a narrow crossing while native creatures scatter from a rift in the water. Her green circuitry and small pink mask heart match the saved ivyrosemasked reference. Ali sees her before she sees him."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Found the safe place, then?",
          "line_id": "MS07_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "You are standing in the unsafe part.",
          "line_id": "MS07_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Missed you too.",
          "line_id": "MS07_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Rose wants to look at him properly, but she keeps watching the failing crossing. Ali sees the effort and takes her place at the rail. Only then does she give him a full look."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Your sleeve.",
          "line_id": "MS07_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Roof.",
          "line_id": "MS07_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Your hand.",
          "line_id": "MS07_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Different roof.",
          "line_id": "MS07_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You found a safe place?",
          "line_id": "MS07_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Working on it.",
          "line_id": "MS07_IN_D09"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali catches the failing rail beside her. They exchange one searching look: reassurance first, relief second. Leave both masks on. Terra reaches the water control so the reunion does not freeze the rescue."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "You were supposed to find a safe place.",
          "line_id": "MS07_IN_D10"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I found people. I thought that counted.",
          "line_id": "MS07_IN_D11"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Rose leads the party across Glitch Gardens into Rustwater. Compare samples from both arrival sites, return the displaced water particles to their anchors, and stop the surge before it reaches the crossing. Rose and Ali work in practiced coordination while the Chibi crew supplies local knowledge."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Their rescue rhythm returns too quickly. Rose says left; Ali moves before checking whether she means the same left. Terra catches the small local creature between their two plans."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Everybody stop being very familiar for a second. We have passengers.",
          "line_id": "MS07_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "My left. Sorry.",
          "line_id": "MS07_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "I knew that.",
          "line_id": "MS07_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "You went right.",
          "line_id": "MS07_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Confidently.",
          "line_id": "MS07_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "They reset together. Ali follows the local hand signal; Rose waits for Terra's confirmation before releasing the sluice."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The danger subsides. Rose grips Ali's wrist where their hands slipped apart."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "You kept the signal.",
          "line_id": "MS07_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You said you would find it.",
          "line_id": "MS07_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "We find our way home together.",
          "line_id": "MS07_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Then we need both of your readings.",
          "line_id": "MS07_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Both of us. Same destination.",
          "line_id": "MS07_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Rose grips Ali's wrist at the place they lost contact. He notices a raw line on her glove and almost makes a joke. Instead he turns her hand carefully."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "How long were you holding the line?",
          "line_id": "MS07_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Until it was not there.",
          "line_id": "MS07_OUT_D07"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Rose--",
          "line_id": "MS07_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "I know. You would have done the same.",
          "line_id": "MS07_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "That is the problem, and both know it. She lets go before the feeling becomes a speech."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Next time we need a better line.",
          "line_id": "MS07_OUT_D10"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "We?",
          "line_id": "MS07_OUT_D11"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "You are not doing the next part alone.",
          "line_id": "MS07_OUT_D12"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Their home signatures remain separate from Chibi addresses. Rose joins the field roster. The scanner points toward the sanctuary's missing light."
        }
      ],
      "visual_direction": {
        "palette": "Garden green / masked faces in soft sky light",
        "framing": "Shared wrist grip echoes rift separation; close eyes remain visible.",
        "sound": "Water pulse ends before the reunion breath."
      },
