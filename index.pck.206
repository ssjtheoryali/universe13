      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS39",
      "sequence": 39,
      "title": "The Wish That Leaves Worlds Free",
      "locations": [
        "Dragon Shrine",
        "final rift boundary"
      ],
      "opening": "Six reassembled Power Cores rise. Blue Dragon follows them between distinct skies.",
      "objective": "Protect alignment and return particles to correct worlds. The wish stabilises earned repair, never obedience.",
      "outcome": "Uncontrolled rifting ends. No merger, memory wipe or instant Terra reset; safe chosen gates become possible.",
      "map_records": [],
      "additional_records": [],
      "legacy_anchors": [],
      "realm": "CHIBI / Blue Dragon",
      "character_turn": "Ali and Rose complete the repair required to reach their own reality safely. Their Chibi friends protect the gate alignment from their side.",
      "dialogue": "Ali: Let them choose what comes next.",
      "expression_cues": "Ali: resolve to wonder; Rose: relief through grief",
      "party_event": "none",
      "chapter": 8,
      "chapter_title": "Home, With a Way Back",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS39_A",
          "sequence": "MS39",
          "cut_id": "MS39_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Six reassembled Power Cores rise. Blue Dragon follows them between distinct skies.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS39_B",
          "sequence": "MS39",
          "cut_id": "MS39_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Ali and Rose complete the repair required to reach their own reality safely. Their Chibi friends protect the gate alignment from their side.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS39_C",
          "sequence": "MS39",
          "cut_id": "MS39_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Let them choose what comes next.",
          "performance_note": "Ali: resolve to wonder; Rose: relief through grief; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS39_D",
          "sequence": "MS39",
          "cut_id": "MS39_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Protect alignment and return particles to correct worlds. The wish stabilises earned repair, never obedience.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS39_E",
          "sequence": "MS39",
          "cut_id": "MS39_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Uncontrolled rifting ends. No merger, memory wipe or instant Terra reset; safe chosen gates become possible.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        },
        {
          "shot_id": "MS39_F",
          "sequence": "MS39",
          "cut_id": "MS39_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into Home, With a Way Back.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_8_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. SIX-CORE ALIGNMENT - DAWN. Six distinct cores rise around the repaired return network. Blue Dragon moves between distinct skies, connecting them without merging their horizons."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I do not want to get this wrong.",
          "line_id": "MS39_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Neither do I.",
          "line_id": "MS39_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I miss when you said the specific plan part.",
          "line_id": "MS39_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "I have one. I am still frightened.",
          "line_id": "MS39_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "He absorbs that she can be afraid and prepared, and that he no longer needs her certainty as proof they will survive."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Okay. Tell me the plan.",
          "line_id": "MS39_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY, RADIO",
          "text": "Alignment is stable.",
          "line_id": "MS39_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Every address stays its own.",
          "line_id": "MS39_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Every world keeps its choice.",
          "line_id": "MS39_IN_D08"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali and Rose look at each other before the wish. Their return is one destination among the restored worlds, not the reason all others exist."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Protect alignment from residual corrupted creatures and unstable matter. Send particles to the correct recorded origins. The film shows the successful defence; the game requires its own earned completion flag. No new villain, seventh core or legendary-evil teaser interrupts the resolution."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The cores align. A wish large enough to remake worlds offers the temptation to ask for every hurt to vanish. Ali's eyes go to Terra's keepsake. Rose sees the thought but does not police it."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "What if--",
          "line_id": "MS39_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "I know.",
          "line_id": "MS39_BRIDGE_D02"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "He looks from the empty place to the separate living worlds. He cannot declare Terra's unknown address, invent a substitute, or turn other people's minds into the answer he wants."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Return what was taken. To where it belongs. Let the worlds stand free.",
          "line_id": "MS39_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The uncontrolled tears close. Separate skies hold. Six cores settle into a stable network whose gates require deliberate choice. The home window opens onto Ali and Rose's actual reality."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "That is home.",
          "line_id": "MS39_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Together.",
          "line_id": "MS39_OUT_D02"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The repaired skies remain distinct. Nothing about the quiet announces that grief has been judged and cured."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "The origins are stable.",
          "line_id": "MS39_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "JUEVY",
          "text": "What about yours?",
          "line_id": "MS39_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Still ours.",
          "line_id": "MS39_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Both of us?",
          "line_id": "MS39_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Both.",
          "line_id": "MS39_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "This time her certainty comes from a verified answer, and she lets herself enjoy saying it."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "No memory wipe, universal obedience, merged population or instant Terra reset. Hold the earned quiet before the final crossing."
        }
      ],
      "visual_direction": {
        "palette": "Separate skies / stable core radiance",
        "framing": "Dragon connects but never dissolves the boundaries of worlds.",
        "sound": "Wish is dry and clear before the score resolves."
      },
      "baseline_shot_ids": [
        "MS39_A",
