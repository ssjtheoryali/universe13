        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Crystal Spire",
      "character_turn": "Its desire for certainty has become the erasure of every imperfect possibility.",
      "dialogue": "Shard: I can stand with you. I won't be owned by you.",
      "expression_cues": "Shard: suspicion to trust; Queen: recognition; Rose: respect",
      "party_event": "join:Shard,Fairy_Queen",
      "chapter": 4,
      "chapter_title": "Different Roads Home",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS17_A",
          "sequence": "MS17",
          "cut_id": "MS17_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Prism Sentinel overlays perfect valleys. Shard holds an evacuation path.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS17_B",
          "sequence": "MS17",
          "cut_id": "MS17_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Its desire for certainty has become the erasure of every imperfect possibility.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS17_C",
          "sequence": "MS17",
          "cut_id": "MS17_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Shard: I can stand with you. I won't be owned by you.",
          "performance_note": "Shard: suspicion to trust; Queen: recognition; Rose: respect; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS17_D",
          "sequence": "MS17",
          "cut_id": "MS17_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Cleanse Sentinel; recover Prism fragments and Lens; beat Glass Hydra; free the local Queen and help Shard.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS17_E",
          "sequence": "MS17",
          "cut_id": "MS17_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "One living valley replaces false reflections. Shard and Queen can join; neither is realistic Rose.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS17_F",
          "sequence": "MS17",
          "cut_id": "MS17_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Shard,Fairy_Queen. Carry the eyeline into A Forest With Room to Breathe.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. PRISM VALLEY - DAY. Sentinel overlays pristine valleys above the damaged living one. Shard holds an evacuation path while reflections tempt residents toward doors that lead nowhere."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SHARD",
          "text": "Left foot on the dark seam. Do not trust the shine.",
          "line_id": "MS17_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You have done this before.",
          "line_id": "MS17_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SHARD",
          "text": "I fell before.",
          "line_id": "MS17_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Shard checks the edge once, then checks it again when a younger local copies the motion. He realizes his caution is being watched."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Does it hold?",
          "line_id": "MS17_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SHARD",
          "text": "It held me. We test your weight separately.",
          "line_id": "MS17_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Sensible. Mildly hurtful.",
          "line_id": "MS17_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SHARD",
          "text": "Mostly sensible.",
          "line_id": "MS17_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "SHARD",
          "text": "The perfect path keeps moving.",
          "line_id": "MS17_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Show me the one your feet trust.",
          "line_id": "MS17_IN_D09"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Shard stamps the solid ledge. Ali tests the real handrail. The local Fairy Queen shelters a separate group; Rose and the Queen occupy the same frame with clearly distinct designs and bodies."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Follow Shard's stable route, defeat Glass Hydra and free the local Queen. Expose and cleanse Sentinel. Recover Prism fragments and the Lens through separate pickups. As false valleys recede, preserve the scratches and repairs of the real settlement."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "A flawless doorway offers the Queen an untouched sanctuary. She reaches, then stops when the reflection's inhabitants move together. Her blasters lower, though the corruption still resists."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "FAIRY QUEEN",
          "text": "I wanted to see it whole.",
          "line_id": "MS17_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "I know.",
          "line_id": "MS17_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "FAIRY QUEEN",
          "text": "You cannot know what it was.",
          "line_id": "MS17_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "No. I know wanting it anyway.",
          "line_id": "MS17_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The Queen looks at this visitor who has not claimed her title or her grief. That honesty lets her turn toward the damaged living valley."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "One imperfect inhabited valley remains. A resident chooses their own battered doorway over its flawless reflection."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "FAIRY QUEEN",
          "text": "It is ours.",
          "line_id": "MS17_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "That is what makes it worth saving.",
          "line_id": "MS17_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "SHARD",
          "text": "If you are still walking, I can take the next watch.",
          "line_id": "MS17_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "SHARD",
          "text": "I can go first at the next crossing.",
          "line_id": "MS17_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You do not have to prove the falling is over.",
          "line_id": "MS17_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "SHARD",
          "text": "It is not over. I just know where to put my feet.",
          "line_id": "MS17_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The Queen uses her own hands to reopen the battered door. Rose waits until invited before helping."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "FAIRY QUEEN",
          "text": "That corner was always crooked.",
          "line_id": "MS17_OUT_D07"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Keep it?",
          "line_id": "MS17_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "FAIRY QUEEN",
          "text": "Keep it.",
          "line_id": "MS17_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Shard and Fairy Queen become earned companions. Neither is labelled Rose's transformation or replacement. The route continues into the living forest."
        }
      ],
      "visual_direction": {
        "palette": "Prism glare / textured real valley",
        "framing": "Reflection edges recede from a resident choosing their own door.",
        "sound": "False shimmer stops; local footsteps remain."
      },
      "baseline_shot_ids": [
        "MS17_A",
        "MS17_B",
        "MS17_C",
        "MS17_D",
        "MS17_E",
        "MS17_F"
      ],
