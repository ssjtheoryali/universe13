    },
    {
      "id": "MS31",
      "sequence": 31,
      "title": "Noki's Own Heartbeat",
      "locations": [
        "Kaiju District",
        "Core Below",
        "tower roof"
      ],
      "opening": "Extraction roots tighten across Noki's arm, Static Heart and crown.",
      "objective": "Complete ascent, Heart cleansing, crown rescue and Core Below; confront Organ after freeing Noki.",
      "outcome": "Noki steadies the crossing with the same open hand shown before the Calamity. He resumes his district-guardian role and supports restoration from the world, rather than becoming a miniature field-party substitute. Organ relinquishes the command crown.",
      "map_records": [
        "core_below",
        "chapter_18",
        "chasm_kaiju",
        "light_core"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_18"
      ],
      "realm": "CHIBI / Final Chain",
      "character_turn": "The crew frees their Chibi Verse peacekeeper and helps him complete the protective action that once kept his district calm. His local identity is restored along with his freedom.",
      "dialogue": "CHIBI JUEVY: There he is. ALI: Welcome back, Noki. ROSE: The anchor's holding.",
      "expression_cues": "Noki: pain to trust; Organ: shame to relief",
      "party_event": "support:Noki;join:Organ",
      "chapter": 7,
      "chapter_title": "The Place Terra Held",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS31_A",
          "sequence": "MS31",
          "cut_id": "MS31_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Extraction roots tighten across Noki's arm, Static Heart and crown.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS31_B",
          "sequence": "MS31",
          "cut_id": "MS31_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "The crew frees their Chibi Verse peacekeeper and helps him complete the protective action that once kept his district calm. His local identity is restored along with his freedom.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS31_C",
          "sequence": "MS31",
          "cut_id": "MS31_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "CHIBI JUEVY: There he is. ALI: Welcome back, Noki. ROSE: The anchor's holding.",
          "performance_note": "Noki: pain to trust; Organ: shame to relief; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS31_D",
          "sequence": "MS31",
          "cut_id": "MS31_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Complete ascent, Heart cleansing, crown rescue and Core Below; confront Organ after freeing Noki.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS31_E",
          "sequence": "MS31",
          "cut_id": "MS31_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Noki steadies the crossing with the same open hand shown before the Calamity. He resumes his district-guardian role and supports restoration from the world, rather than becoming a miniature field-party substitute. Organ relinquishes the command crown.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS31_F",
          "sequence": "MS31",
          "cut_id": "MS31_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: support:Noki;join:Organ. Carry the eyeline into Ali Versus Pixel.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. NOKI ASCENT - DAWN. Ali stands beside the same hand from MS09 and MS10. It trembles against the extraction roots. Juevy lays a small hand on the armour."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Hey, big friend. Same bridge. Worse weather.",
          "line_id": "MS31_IN_D01"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "He gives the small familiar wave from the recording. Noki's fingers move toward the open-hand gesture, then seize."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "We are not asking you to hold everything.",
          "line_id": "MS31_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Just the bit you can.",
          "line_id": "MS31_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "We will take the next bit.",
          "line_id": "MS31_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "We found your road back.",
          "line_id": "MS31_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You hold the crossing. We will handle what is holding you.",
          "line_id": "MS31_IN_D06"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Match the camera angle from the peaceful recording. The difference is the corruption, not Noki's identity or anatomy."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Ascend the arm, cleanse Static Heart, free the crown and reach Core Below. Remove the roots without destroying the chest modules or visor. Free Noki before confronting Organ. The film gives each stage a distinct physical waypoint; in play the same stage flags unlock the next safe route."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "During the ascent, Ali tries to hold a slipping brace and the route at once. Terra reaches the second support, then waits for his eye contact before taking it. This time neither quietly does both jobs."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Give me that one.",
          "line_id": "MS31_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Ready?",
          "line_id": "MS31_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Now.",
          "line_id": "MS31_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The same shared count that raised a shelter beam carries them through Noki's Static Heart. Cleanse the heart before the crown confrontation. Organ grips the command crown after its authority is gone."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ORGAN",
          "text": "It made the noise sound like certainty.",
          "line_id": "MS31_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "You can put it down without knowing every next step.",
          "line_id": "MS31_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The open hand stops shaking. Noki steadies the crossing and looks toward the small residents gathering at its entrance. No long explanatory speech is needed. Organ relinquishes the command crown."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ORGAN",
          "text": "It is quiet.",
          "line_id": "MS31_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "That is his own heartbeat.",
          "line_id": "MS31_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Welcome back.",
          "line_id": "MS31_OUT_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Noki's palm levels. Juevy crosses it slowly, giving him time to choose each motion."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "NOKI",
          "text": "...Noki big.",
          "line_id": "MS31_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "JUEVY",
          "text": "Had noticed.",
          "line_id": "MS31_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "NOKI",
          "text": "Noki tired.",
          "line_id": "MS31_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Then we stop asking you to do this alone.",
          "line_id": "MS31_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Noki sits beside the crossing rather than collapsing into another battle pose. Organ lays the crown where anyone could pick it up, then deliberately steps away."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ORGAN",
          "text": "The crown was never mine. Take the city back.",
          "line_id": "MS31_OUT_D08"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Noki resumes his district-guardian role from the world, supporting restoration at giant scale. Organ's earned joining state is separate. Do not shrink Noki into a travelling substitute."
        }
      ],
      "visual_direction": {
        "palette": "True dawn / stable green visor",
        "framing": "Repeat Noki open-hand view without the tremor.",
        "sound": "Own heartbeat takes over; leave room for silence."
      },
      "baseline_shot_ids": [
        "MS31_A",
        "MS31_B",
        "MS31_C",
        "MS31_D",
        "MS31_E",
        "MS31_F"
      ],
      "gameplay_entry": {
        "cut": "MS31_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
      "gameplay_exit": {
        "cut": "MS31_OUT",
        "requires": "MS31_objective_complete",
        "quest_flag_is_proposed_binding": true,
        "source_legacy_anchors": [
          "chapter_18"
        ],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS32",
      "sequence": 32,
      "title": "Ali Versus Pixel",
      "locations": [
        "Juevygang Tower"
      ],
      "opening": "Tower lights fail in the rhythm that controlled the opening streets.",
      "objective": "Defeat canon Season 1 Pixel; shut down the ground siphon without overwriting anyone.",
      "outcome": "Ground extraction stops, but the lunar engine threatens the returns.",
      "map_records": [
        "chapter_19"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_19"
      ],
      "realm": "CHIBI / Siphon Core",
      "character_turn": "Pixel offers Ali and Rose a private exit if they abandon their allies.",
      "dialogue": "Rose: We don't get home by taking theirs.",
      "expression_cues": "Ali and Rose: resolve; Pixel: disbelief and rage",
      "party_event": "none",
      "chapter": 7,
      "chapter_title": "The Place Terra Held",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS32_A",
          "sequence": "MS32",
          "cut_id": "MS32_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Tower lights fail in the rhythm that controlled the opening streets.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS32_B",
          "sequence": "MS32",
          "cut_id": "MS32_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Pixel offers Ali and Rose a private exit if they abandon their allies.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS32_C",
          "sequence": "MS32",
          "cut_id": "MS32_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Rose: We don't get home by taking theirs.",
          "performance_note": "Ali and Rose: resolve; Pixel: disbelief and rage; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS32_D",
          "sequence": "MS32",
          "cut_id": "MS32_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Defeat canon Season 1 Pixel; shut down the ground siphon without overwriting anyone.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS32_E",
          "sequence": "MS32",
          "cut_id": "MS32_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Ground extraction stops, but the lunar engine threatens the returns.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS32_F",
          "sequence": "MS32",
          "cut_id": "MS32_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into Ali Ski, Meet Ali Ski.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. GROUND SIPHON TOWER - DAY. Lights pulse in the rhythm heard at the opening crossing. Pixel stands within the control geometry. Ali stops outside the dangerous line; Rose moves toward the address console."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "I expected you to come alone.",
          "line_id": "MS32_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I used to think that looked better.",
          "line_id": "MS32_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "It would be more efficient.",
          "line_id": "MS32_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "For you.",
          "line_id": "MS32_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Pixel looks past the crew to the return controls. He can discuss a whole planet with perfect calm, but the possibility of losing one command makes him grip the console."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You can still stop the pull.",
          "line_id": "MS32_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "And leave the worlds to fail again?",
          "line_id": "MS32_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Leave them to live.",
          "line_id": "MS32_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "I can put everything where it belongs.",
          "line_id": "MS32_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You do not get to decide where we belong.",
          "line_id": "MS32_IN_D09"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PIXEL",
          "text": "You are strangers here.",
          "line_id": "MS32_IN_D10"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "So were the worlds you started taking apart.",
          "line_id": "MS32_IN_D11"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Frame Pixel at his actual Chibi scale with intimidating spatial control, not redesigned human anatomy. Terra's position depends on the saved party; her required story action can occur by radio."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Defeat Season 1 Pixel, open the siphon safeguards and return control of the address records. Ali attacks exposed defences while Rose and the earned crew isolate the return channels. Shut down the ground siphon only after the records are protected. No obedient-world wish is used as a shortcut."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "You want to go home. I could arrange the return.",
          "line_id": "MS32_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "To our address?",
          "line_id": "MS32_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL",
          "text": "To a suitable state.",
          "line_id": "MS32_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "That was not the question.",
          "line_id": "MS32_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Pixel's answer is another pristine diagram, not an origin confirmation. Ali looks once toward its imitation of home and then destroys the command bridge, leaving the actual address ledger protected."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "We are done being offered somebody else's life.",
          "line_id": "MS32_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The tower goes dark. On the live route map, a lunar pulse continues."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "Ground extraction stopped. The return is still being pulled upward.",
          "line_id": "MS32_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "The repair coupler can reverse that flow.",
          "line_id": "MS32_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Then we take the repair to it.",
          "line_id": "MS32_OUT_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The ground siphon stops. Pixel reaches for an inert command. It does not obey. Nobody celebrates his humiliation; the cost is outside the tower."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA, REQUIRED GUEST OR RADIO",
          "text": "The upper return is still under load.",
          "line_id": "MS32_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Lunar engine?",
          "line_id": "MS32_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Yes. We can reverse it. We do it with a plan.",
          "line_id": "MS32_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Ali looks at Rose before moving. She confirms. Even in urgency, he now waits for the shared decision."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Pixel's ground defeat is earned; do not claim final victory while the lunar engine remains. His later physical fate is not invented beyond stopping his Season 1 operation."
        }
      ],
      "visual_direction": {
        "palette": "Tower deep contrast / independent return indicators",
        "framing": "Keep fight and address console in connected geography.",
        "sound": "Opening extraction rhythm stops at the ground shutdown."
      },
      "baseline_shot_ids": [
        "MS32_A",
        "MS32_B",
        "MS32_C",
        "MS32_D",
        "MS32_E",
        "MS32_F"
      ],
      "gameplay_entry": {
        "cut": "MS32_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
      "gameplay_exit": {
