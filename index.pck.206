        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Whisperwood",
      "character_turn": "Ali and Terra share a meal. Patch tests whether they return for weaker creatures.",
      "dialogue": "Patch: You came back for them.",
      "expression_cues": "Patch: hope to warmth; Terra: laugh; Ali: ease",
      "party_event": "join:Patch",
      "chapter": 4,
      "chapter_title": "Different Roads Home",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
