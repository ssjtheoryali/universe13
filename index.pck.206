    },
    {
      "id": "MS29",
      "sequence": 29,
      "title": "Order Without Consent",
      "locations": [
        "Juevygang Tower",
        "Juevygang Central",
        "The Abyss"
      ],
      "opening": "Pixel addresses people as resources inside his repair design.",
      "objective": "Fight defenses, sever command route and recover consumed-particle records.",
      "outcome": "Terra chooses the people she helped. Pixel escalates extraction.",
      "map_records": [
        "juevygang_tower",
        "chapter_16",
        "updraft_tower"
      ],
      "additional_records": [
        {
          "name": "JUEVYGANG CENTRAL",
