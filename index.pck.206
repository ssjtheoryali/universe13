        "chapter_08"
      ],
      "realm": "CHIBI / Kaiju District",
      "character_turn": "This is a distinct Chibi Verse resident whose peaceful role has been corrupted, not a realistic Noki shrunk into a toy or a giant introduced only to be fought.",
      "dialogue": "ALI: He's still trying to help. ROSE: Then we help him.",
      "expression_cues": "Noki: restraint, distress, brief recognition; Ali: resolve; Rose: empathy; Juevy: worried trust",
      "party_event": "none",
      "chapter": 2,
      "chapter_title": "The Masked Rose",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS10_A",
