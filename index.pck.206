}[Ã´‡ç®Ûð£¶õAÃ‘¡°¾°ŒÇþ8@¿™\µÿ}ý\€Îá¿9zas?µàŠ#6àíOc…±ÎA4ž3¢+␀␀␀␀␀␀shader_type spatial;
// UNIVERSE 13 Â· BAKE-OFF CEL DETAIL (game/gfx_buff.gd, Theory 2026-10-19: "look the same as the test graphics with cel shade").
// The engine bake-off's cel retexture (tests/bakeoff/retexture.gdshader, TOON branch) made general: any model keeps its own colour
// (albedo texture x colour x vertex colour) and gets real tiling stone as luminance detail, in world space (triplanar, no UVs):
// cobblestone on floors, castle brick on light walls, rock face on dark walls. Two-band toon light + rim, like the bake-off's cel look.

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform vec4 albedo_col : source_color = vec4(1.0);
uniform bool use_vcol = false;
uniform vec3 uv_scale = vec3(1.0);
uniform vec3 uv_offset = vec3(0.0);
uniform sampler2D brick_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D cobble_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rock_a : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float brick_scale = 0.33;    // tiles per metre (castle_brick_07 covers ~3 m)
uniform float cobble_scale = 0.5;
uniform float rock_scale = 0.2;
uniform float detail = 0.6;          // how strongly the stone's light / dark pattern shows on the model's colour
uniform float rim = 0.4;
uniform float rim_tint = 0.7;
uniform vec4 emission_col : source_color = vec4(0.0);

varying vec3 wpos;
varying vec3 wnrm;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnrm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec3 tri_w(vec3 n) {
	vec3 w = pow(abs(n), vec3(6.0));
	return w / (w.x + w.y + w.z);
}

vec4 tri(sampler2D t, vec3 p, vec3 w, float s) {
	return texture(t, p.zy * s) * w.x + texture(t, p.xz * s) * w.y + texture(t, p.xy * s) * w.z;
}

void fragment() {
	vec3 base = texture(albedo_tex, UV * uv_scale.xy + uv_offset.xy).rgb * albedo_col.rgb;
	if (use_vcol) base *= COLOR.rgb;
	vec3 n = normalize(wnrm);
	vec3 w = tri_w(n);
	float lum = dot(base, vec3(0.299, 0.587, 0.114));
	float floor_k = smoothstep(0.62, 0.82, n.y);
	float light_wall = smoothstep(0.24, 0.36, lum);
	vec3 a_wall = mix(tri(rock_a, wpos, w, rock_scale).rgb, tri(brick_a, wpos, w, brick_scale).rgb, light_wall);
	vec3 stone = mix(a_wall, tri(cobble_a, wpos, w, cobble_scale).rgb, floor_k);
	float s_lum = dot(stone, vec3(0.299, 0.587, 0.114));
	// bake-off TOON: stone luminance detail x the model's own hue, a little calmer and brighter under the cel ramp
	vec3 col = base * mix(1.0, s_lum / 0.42, detail);
	ALBEDO = mix(col, base, 0.35);
	ROUGHNESS = 0.8;
	SPECULAR = 0.2;
	EMISSION = emission_col.rgb * emission_col.a;
}

void light() {
	float nl = dot(NORMAL, LIGHT);
	float band = smoothstep(-0.05, 0.05, nl) * 0.7 + smoothstep(0.45, 0.55, nl) * 0.3;
	DIFFUSE_LIGHT += band * ATTENUATION * LIGHT_COLOR * ALBEDO / PI * 2.0;
	float r = smoothstep(0.62, 0.7, 1.0 - max(dot(NORMAL, VIEW), 0.0)) * smoothstep(-0.2, 0.3, nl);
	DIFFUSE_LIGHT += r * rim * mix(vec3(1.0), ALBEDO, rim_tint) * LIGHT_COLOR * ATTENUATION * 0.5;
}
␀␀// UNIVERSE 13 Â· MEGA CITY 13 facades: glass + stone towers with thousands of windows, some lit, drawn by one shader
// (no textures, so a whole skyline costs almost nothing). Roofs are plain concrete.
shader_type spatial;
render_mode diffuse_burley;

uniform vec3 stone_a : source_color = vec3(0.16, 0.18, 0.24);
uniform vec3 stone_b : source_color = vec3(0.52, 0.48, 0.44);
uniform vec3 glass : source_color = vec3(0.05, 0.08, 0.12);
uniform vec3 lit_a : source_color = vec3(1.0, 0.82, 0.5);
uniform vec3 lit_b : source_color = vec3(0.55, 0.85, 1.0);
uniform float glow = 1.2;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

void fragment() {
	vec3 n = abs(wn);
	float tower = hash(floor(NODE_POSITION_WORLD.xz * 0.1));   // each building its own tone and window style
	vec2 uv = n.x > n.z ? wp.zy : wp.xy;
	vec2 cs = mix(vec2(3.0, 3.6), vec2(4.2, 4.0), tower);
	vec2 cell = floor(uv / cs); vec2 f = fract(uv / cs);
	float band = step(0.5, fract(tower * 7.3));   // some towers are glass curtain walls, some are stone with punched windows
	float win = mix(step(0.14, f.x) * step(f.x, 0.86) * step(0.22, f.y) * step(f.y, 0.82), step(0.04, f.x) * step(0.1, f.y), band);
	float on = step(0.58, hash(cell + tower * 31.0));
	vec3 base = mix(stone_a, stone_b, tower);
	vec3 col = mix(base, glass + base * 0.15, win);
	float roof = step(0.7, n.y);
	ALBEDO = mix(col, vec3(0.32, 0.32, 0.33), roof);
	METALLIC = win * 0.7 * (1.0 - roof);
	ROUGHNESS = mix(0.85, 0.12, win * (1.0 - roof));
	EMISSION = win * on * (1.0 - roof) * mix(lit_a, lit_b, hash(cell * 1.7)) * glow;
}
