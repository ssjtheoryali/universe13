          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS09_D",
          "sequence": "MS09",
          "cut_id": "MS09_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Trace Noki's local peacekeeping route through the square, shrine, tunnels, pump station and flooded vault to recover the return-anchor signal Ali and Rose need for their reality.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS09_E",
          "sequence": "MS09",
          "cut_id": "MS09_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The same steadying hand seen in the peaceful recording now trembles under rift corruption. Ali and Rose understand that restoring this world's guardian is the way forward, not defeating a copy of someone from home.",
