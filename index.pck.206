      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS36",
      "sequence": 36,
      "title": "Marigolds for the Missing",
      "locations": [
        "Haunt Hollow",
        "Nightshade",
        "La Catrina Eterna",
        "Marigold Gate",
        "Marigold Return"
      ],
      "opening": "The bone ship rises over Haunt Hollow as the crew carries grief.",
      "objective": "Help inhabitants, cleanse Madre, recover Marigold Heart and Spirit Step and restore streets.",
      "outcome": "Colour returns without reversing Terra's loss. Her story is not declared finished.",
      "map_records": [
        "haunt_hollow",
        "la_catrina_eterna",
        "save_haunt_hollow",
        "beat_catrina_arrive",
        "beat_madre_rises",
        "beat_madre_falls",
        "marigold_gate",
        "marigold_return",
        "post_haunt_hollow"
      ],
      "additional_records": [
        {
          "name": "NIGHTSHADE",
