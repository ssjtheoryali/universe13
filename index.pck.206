      "timing_status": "unlocked"
    },
    {
      "id": "MS35",
      "sequence": 35,
      "title": "The Place Terra Held",
      "locations": [
        "moon approach",
        "orbital platforms",
        "lunar breach"
      ],
      "opening": "Dogfighting becomes mech combat as the engine opens a planet-erasure corridor.",
      "objective": "Disable engine, redirect particles and evacuate. Her loss is authored, never punishment for party selection.",
      "outcome": "Terra's signal is lost as the breach closes. No confirmed death or instant resurrection. Pixel's Season 1 plan ends.",
      "map_records": [],
      "additional_records": [],
      "legacy_anchors": [],
      "realm": "CHIBI / Lunar Installation",
      "character_turn": "Terra holds the coupler; her choice follows care shown throughout the journey.",
      "dialogue": "Terra: Keep the road open for everyone else.",
      "expression_cues": "Terra: steady fear; Ali: panic, refusal, silence",
      "party_event": "lost:Terra",
      "chapter": 7,
      "chapter_title": "The Place Terra Held",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS35_A",
          "sequence": "MS35",
          "cut_id": "MS35_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Dogfighting becomes mech combat as the engine opens a planet-erasure corridor.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS35_B",
