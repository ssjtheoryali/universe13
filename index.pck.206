      "legacy_anchors": [],
      "realm": "CHIBI / Mirror Lake",
      "character_turn": "The rift offers a counterfeit route home. Rose recognises the wrong particle signature; they refuse a crossing that would put them in somebody else's lives.",
      "dialogue": "Ali: Not somebody else's place in it.",
      "expression_cues": "Ali: temptation to resolve; Rose: relief",
      "party_event": "return:local_support",
      "chapter": 4,
      "chapter_title": "Different Roads Home",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS20_A",
          "sequence": "MS20",
          "cut_id": "MS20_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Ali's reflection moves late; Chibi Ali glimpsed across the lake has his own life.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS20_B",
          "sequence": "MS20",
          "cut_id": "MS20_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "The rift offers a counterfeit route home. Rose recognises the wrong particle signature; they refuse a crossing that would put them in somebody else's lives.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS20_C",
          "sequence": "MS20",
          "cut_id": "MS20_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Not somebody else's place in it.",
          "performance_note": "Ali: temptation to resolve; Rose: relief; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS20_D",
          "sequence": "MS20",
          "cut_id": "MS20_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Restore Hollowmere, Mirror Shrine, crag, caves, north shore and cloudbreak; escort residents home.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS20_E",
          "sequence": "MS20",
          "cut_id": "MS20_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Ali rejects swapping lives. The support ally returns after local repairs.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS20_F",
          "sequence": "MS20",
          "cut_id": "MS20_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: return:local_support. Carry the eyeline into The Sky Needs a Crew.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. HOLLOWMERE - MORNING. Ali's reflection turns a fraction late. Across the lake, Chibi Ali briefly passes on a local errand, too far away for an introduction. The reflection offers an easier, familiar-looking route."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Our street has that light.",
          "line_id": "MS20_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "The sign is wrong.",
          "line_id": "MS20_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I know.",
          "line_id": "MS20_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "He has not checked the sign. Rose starts to correct him again, then sees what he is actually doing: remembering the ordinary view without wanting another crisis from it."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "You can look.",
          "line_id": "MS20_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I know.",
          "line_id": "MS20_IN_D05"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "This time the same words mean something different. She stands beside him instead of pulling him away."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "That one looks like our street.",
          "line_id": "MS20_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Look at the signal.",
          "line_id": "MS20_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali checks. The image is familiar; the origin address is wrong. He steps away before the reflection can finish beckoning."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Close is not home.",
          "line_id": "MS20_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "And another life is not ours to take.",
          "line_id": "MS20_IN_D09"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Restore Hollowmere, Mirror Shrine, crag, caves, north shore and cloudbreak; escort residents to their real doors. The local support ally previously assigned here completes the repair and can return. Keep that identity resolved from saved party state rather than adding a mandatory invented recruit."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "A resident chooses the less polished doorway. Ali waits rather than pointing them toward the apparent better home. Across the water, Chibi Ali hurries along his own route and stops to fix a shifted marker."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "He does have a good walk.",
          "line_id": "MS20_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "He appears to use it to get places.",
          "line_id": "MS20_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "That felt unnecessarily specific.",
          "line_id": "MS20_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "It was.",
          "line_id": "MS20_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Rose lets herself enjoy the joke. The moment of home hunger has passed without becoming a moral failure."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The water reflects on time. Chibi Ali has continued his own day across the lake. Realistic Ali watches briefly, curious rather than threatened."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Somebody over there has my walk.",
          "line_id": "MS20_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Save that conversation for a bridge that stays still.",
          "line_id": "MS20_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "I keep thinking we will go back and everything will feel exactly right.",
          "line_id": "MS20_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "The street might. We will have been somewhere else.",
          "line_id": "MS20_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "You make that sound inconvenient.",
          "line_id": "MS20_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "I have met us.",
          "line_id": "MS20_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "He looks at the little cup safely clipped into his pack, then toward the separate Chibi city. Taking something with him is different from taking someone's place."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "The real route opens toward the sky. This glimpse sets up MS33 but does not replace the mandatory comic meeting."
        }
      ],
      "visual_direction": {
        "palette": "Still lake / honest reflected sunlight",
        "framing": "Keep the delayed reflection and wrong address readable together.",
        "sound": "Reflected movement has delayed sound until restored."
      },
      "baseline_shot_ids": [
        "MS20_A",
        "MS20_B",
        "MS20_C",
        "MS20_D",
        "MS20_E",
        "MS20_F"
      ],
      "gameplay_entry": {
