          "source": "game/js/world_v4.js"
        }
      ],
      "legacy_anchors": [
        "chapter_16"
      ],
      "realm": "CHIBI / Tower",
      "character_turn": "He calls obedience order. Ali rejects buying home by erasing another world.",
      "dialogue": "Ali: You don't get to decide who deserves a world.",
      "expression_cues": "Pixel: superiority to anger; Terra: resolve",
      "party_event": "none",
      "chapter": 6,
      "chapter_title": "Order Without Consent",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS29_A",
          "sequence": "MS29",
          "cut_id": "MS29_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Pixel addresses people as resources inside his repair design.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS29_B",
          "sequence": "MS29",
          "cut_id": "MS29_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "He calls obedience order. Ali rejects buying home by erasing another world.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS29_C",
          "sequence": "MS29",
          "cut_id": "MS29_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: You don't get to decide who deserves a world.",
          "performance_note": "Pixel: superiority to anger; Terra: resolve; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS29_D",
          "sequence": "MS29",
          "cut_id": "MS29_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Fight defenses, sever command route and recover consumed-particle records.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS29_E",
          "sequence": "MS29",
          "cut_id": "MS29_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Terra chooses the people she helped. Pixel escalates extraction.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS29_F",
          "sequence": "MS29",
          "cut_id": "MS29_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into People Almost Forgotten.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. COMMAND DEFENCES - NIGHT. Doors close in identical rhythm. Residents on a remote monitor move as if their paths were prescribed. Terra studies the failed connection to her brother, then shuts its private channel."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You can be angry with him.",
          "line_id": "MS29_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I am.",
          "line_id": "MS29_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You can miss him too.",
          "line_id": "MS29_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I do not know which version you think I am missing.",
          "line_id": "MS29_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali almost offers a reassuring account of a brother he has never known. He stops."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Then I will not guess.",
          "line_id": "MS29_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "What do you need from us?",
          "line_id": "MS29_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "Do not ask me to be the person who changes his mind.",
          "line_id": "MS29_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "All right.",
          "line_id": "MS29_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You do not have to explain him to us.",
          "line_id": "MS29_IN_D09"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I am not going to.",
          "line_id": "MS29_IN_D10"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "What do you want to do?",
          "line_id": "MS29_IN_D11"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "Get these people out.",
          "line_id": "MS29_IN_D12"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Let Terra initiate the first rescue action. Her family connection grants no magical bypass or guaranteed change of heart."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Fight the defences, sever the command route and recover the consumed-particle records before the terminal collapses. Pixel addresses the party through the public system only after his authorized reveal."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL, SYSTEM",
          "text": "I could prevent the injuries you are about to receive.",
          "line_id": "MS29_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "You could also open the door.",
          "line_id": "MS29_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL, SYSTEM",
          "text": "Only after the obstruction is removed.",
          "line_id": "MS29_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "He means us.",
          "line_id": "MS29_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "I know what he means.",
          "line_id": "MS29_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "She flinches at her own sharpness. Ali does not demand an apology during the fight. He takes the failing support she indicates."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Left connector.",
          "line_id": "MS29_BRIDGE_D06"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Got it.",
          "line_id": "MS29_BRIDGE_D07"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "Thank you.",
          "line_id": "MS29_BRIDGE_D08"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PIXEL, SYSTEM",
          "text": "Your repairs preserve disorder.",
          "line_id": "MS29_BRIDGE_D09"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "They preserve people.",
          "line_id": "MS29_BRIDGE_D10"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The record shows that stopping the ground siphon alone will leave an off-world extraction engine active. Theory begins isolating its destination."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "He has somewhere else to finish this.",
          "line_id": "MS29_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Then we do not stop halfway.",
          "line_id": "MS29_OUT_D02"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The record exposes the off-world engine. Terra studies its repair interface, then notices Rose watching her hands."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "You think I am going to do something reckless.",
          "line_id": "MS29_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "I think you know how to do something useful. I want us to plan for the part you cannot hold yourself.",
          "line_id": "MS29_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "...Then stay for the whole plan.",
          "line_id": "MS29_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Rose pulls up a seat. This is preparation for shared repair, not permission for a secret sacrifice."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Save the records. The action reveals the next technical obstacle, never Pixel's hidden historical motive."
        }
      ],
      "visual_direction": {
        "palette": "Command grid / local life outside it",
        "framing": "Terra closes the private channel and initiates the rescue.",
        "sound": "Public Pixel system is permitted after reveal."
      },
      "baseline_shot_ids": [
        "MS29_A",
        "MS29_B",
        "MS29_C",
        "MS29_D",
        "MS29_E",
        "MS29_F"
      ],
      "gameplay_entry": {
        "cut": "MS29_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
