    },
    {
      "id": "MS12",
      "sequence": 12,
      "title": "The Roads That Recruit",
      "locations": [
        "Static Crossing",
        "Brightwater",
        "Juevy Junction",
        "Critter Lake",
        "The Wilds",
        "Residential District",
        "east cliffs"
      ],
      "opening": "Sakura Pop, Bun Bun and Rocket each keep a different stranded group moving.",
      "objective": "Reconnect Static Crossing, Brightwater, Juevy Junction, Critter Lake, residential roads, Wilds and cliffs.",
      "outcome": "Chosen recruits travel; other volunteers remain visible on supply routes and at HQ.",
      "map_records": [
        "static_crossing",
        "brightwater",
        "save_static_crossing",
        "save_brightwater",
