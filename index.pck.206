// projected in world space (triplanar), adds grain and bumps so a 250 m world never looks blurry when you stand on it.
// Tops get the ground surface, walls get the rock surface.
shader_type spatial;
render_mode cull_back, diffuse_burley;

uniform sampler2D base_tex : source_color, filter_linear_mipmap_anisotropic;
uniform vec4 base_col : source_color = vec4(1.0);
uniform sampler2D d_top : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D d_side : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_top : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_side : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float scale = 0.3;
uniform float strength = 0.8;

varying vec3 wp;
varying vec3 wn;

void vertex() {
	wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wn = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

void fragment() {
	vec3 base = texture(base_tex, UV).rgb * base_col.rgb;
	float up = smoothstep(0.5, 0.85, wn.y);
	// only the surface this pixel actually shows is sampled (walls: one rock projection, tops: the ground): cheap on this GPU
	vec2 suv = abs(wn.x) > abs(wn.z) ? wp.zy : wp.xy;
	vec3 det; vec3 nm;
	if (up < 0.02) { det = texture(d_side, suv * scale).rgb; nm = texture(n_side, suv * scale).rgb; }
	else if (up > 0.98) { det = texture(d_top, wp.xz * scale).rgb; nm = texture(n_top, wp.xz * scale).rgb; }
	else {
		det = mix(texture(d_side, suv * scale).rgb, texture(d_top, wp.xz * scale).rgb, up);
		nm = mix(texture(n_side, suv * scale).rgb, texture(n_top, wp.xz * scale).rgb, up);
	}
	float lum = dot(det, vec3(0.299, 0.587, 0.114));
	vec3 col = base * mix(1.0, clamp(lum / 0.38, 0.35, 1.8), strength);
	col = mix(col, det * dot(base, vec3(0.333)) / max(lum, 0.05), 0.18 * up);
	ALBEDO = col;
	ROUGHNESS = 0.88;
	NORMAL_MAP = nm;
	NORMAL_MAP_DEPTH = 1.1;
}␀␀␀␀␀␀␀␀␀␀GDSCe␀␀␀ð␀(µ/ý ð␀l~òÆÃGéÕ´UÕ¬Y¢ù1"v&›ìXÇ*JøôË\U¤¹2´ŠÆÆ¾£ƒb·ô¸¸ê+Ý´ht­z©mþÿÿßv[“)ÕúV· ¾Mô-Ü¼Eô-º¼%á[¼x;Â·0ñV„g1ÄÛCÏ‚ÓÛžÜÛâ³xô„gqÁÛžœ·†žo=‹1o	=‹'o=o=ø?¼íàWôð–ƒ_q¾ÝàW„ðVÐ¯¨àm _ç­¿¢ì­Û¯ {›Á¯hòƒ_Áã-␀^Eo½ŠJo/x“ÞZð*(x[Á«`Sá{;Á«ðz+Á«`ò6‚W‘ä-ñU¬xÁ§ÐôöÏ§˜ôöOaè­ŸOÑö¶Ï§Hó–Ï§P{»çS,ðVÏ§ø½Íó)È¼uàS$"ÉÛ;Ÿ"€·kŸÅ[óQüðö>ŠÞºyÆ·m	oÙ<
