          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS15_C",
          "sequence": "MS15",
          "cut_id": "MS15_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Rose: Let them make the crossing.",
          "performance_note": "Rose: empathy; Captain: grief to release; Pinto: resolve; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS15_D",
          "sequence": "MS15",
          "cut_id": "MS15_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Rescue workers with Pinto; cleanse Captain; recover Tide fragments and Sea Boots; restore docks, freight and Wreck Room.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS15_E",
          "sequence": "MS15",
          "cut_id": "MS15_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The bell signals living ferries. Pinto offers to travel.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS15_F",
          "sequence": "MS15",
          "cut_id": "MS15_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Pinto. Carry the eyeline into More Than One World.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. RUSTED FREIGHT LANES - FOGGY DAY. A ship's bell rings without movement. Drowned Captain holds a vessel in the harbour, endlessly waiting for passengers who cannot board. Pinto guides living workers away from the water."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PINTO",
          "text": "Bell means wait.",
          "line_id": "MS15_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "For what?",
          "line_id": "MS15_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PINTO",
          "text": "Used to mean a passenger was running for the dock. You wait. Does not matter who is late.",
          "line_id": "MS15_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "And now?",
          "line_id": "MS15_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PINTO",
          "text": "He keeps hearing one more.",
          "line_id": "MS15_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "PINTO",
          "text": "He hears the bell. Not us.",
          "line_id": "MS15_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Then we get the living voices above it.",
          "line_id": "MS15_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Point me to the trapped lane.",
          "line_id": "MS15_IN_D08"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "A freight chain tightens as extraction drains the water. Keep the rescue geography clear: occupied gantry, safe dock, corrupted ship."
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Pinto watches a worker arguing to return for a dropped bag. He does not mock the attachment. He ties a retrieval line to a safe point before moving the person."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Rescue the workers with Pinto, release the freight controls and cleanse Captain at the source of the trapped bell pulse. Recover Tide fragments and Sea Boots separately. Restore docks, freight and Wreck Room so the next real ferry can leave."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The bell interrupts every rescue call. Pinto repeats each instruction patiently, one worker at a time. Ali tries shouting above it."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PINTO",
          "text": "You can be louder than the bell or more useful. Pick the one that saves your breath.",
          "line_id": "MS15_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "You always this calm?",
          "line_id": "MS15_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "PINTO",
          "text": "No. I just do not hand the panic to the next person.",
          "line_id": "MS15_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Ali lowers his voice and repeats a worker's name from the manifest before giving the instruction. They finally hear him."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The bell rings once, then stops. A living ferry answers. Captain releases the mooring, allowing the passage he meant to protect."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PINTO",
          "text": "That one has people to carry.",
          "line_id": "MS15_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Let us make sure they reach the other side.",
          "line_id": "MS15_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "And keep a record of where they started.",
          "line_id": "MS15_OUT_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The Captain lets go. Pinto gives the wheel space, refusing to treat release as something to celebrate in its owner's face."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Do we ring it?",
          "line_id": "MS15_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PINTO",
          "text": "When there is somebody to carry.",
          "line_id": "MS15_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "A living ferry approaches. Pinto waits until its passengers are visible, then gives one measured strike."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Not for the empty ship.",
          "line_id": "MS15_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "PINTO",
          "text": "For the next one.",
          "line_id": "MS15_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Pinto can join; others maintain the freight route. Origin coordinates from the water do not match either traveller's world, widening the mystery."
        }
      ],
      "visual_direction": {
        "palette": "Freight fog / one bell highlight",
        "framing": "Keep living dock and empty vessel on opposite planes.",
        "sound": "The held bell releases; the real ferry answers."
      },
      "baseline_shot_ids": [
        "MS15_A",
        "MS15_B",
        "MS15_C",
