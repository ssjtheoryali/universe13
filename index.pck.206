          "camera": "Emotional close-up / held reaction",
          "action": "Rose: Something is pulling from the other end.",
          "performance_note": "Rose: concern; Seraphine: strain to trust; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_2_Storyboard.png"
        },
        {
          "shot_id": "MS08_D",
