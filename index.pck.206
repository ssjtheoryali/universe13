        },
        {
          "name": "SKYFALL VILLAGE",
          "main_sequence": "MS21",
          "source": "game/js/world_v4.js"
        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Sky Road",
      "character_turn": "Roc's desire for an unconquerable sky has caught Waltz and Tobile in corruption.",
      "dialogue": "Kikimo: If the sky moves, we move together.",
      "expression_cues": "Kikimo: brave fear to joy; Tobile: recognition; Waltz: relief",
      "party_event": "join:Kikimo,Waltz,Tobile",
      "chapter": 5,
      "chapter_title": "Six Broken Lights",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS21_A",
          "sequence": "MS21",
          "cut_id": "MS21_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Kikimo holds a drifting beacon. Storm Roc treats every visitor as an intruder.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS21_B",
          "sequence": "MS21",
          "cut_id": "MS21_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Roc's desire for an unconquerable sky has caught Waltz and Tobile in corruption.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS21_C",
          "sequence": "MS21",
          "cut_id": "MS21_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Kikimo: If the sky moves, we move together.",
          "performance_note": "Kikimo: brave fear to joy; Tobile: recognition; Waltz: relief; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS21_D",
          "sequence": "MS21",
          "cut_id": "MS21_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Cleanse Roc; recover Storm fragments and Wind Charm; free Waltz and Tobile; beat Thunder Kite; restore every sky stop to Star Dock and Terrace Room.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS21_E",
          "sequence": "MS21",
          "cut_id": "MS21_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Kikimo joins. Six core families are represented but still incomplete.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS21_F",
          "sequence": "MS21",
          "cut_id": "MS21_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Kikimo,Waltz,Tobile. Carry the eyeline into The Show That Stole Colour.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. DRIFTING SKY BEACON - DAY. Kikimo holds the beacon against the wind. Above, Storm Roc dives at every approaching shape, driving even the residents from their own dock."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "KIKIMO",
          "text": "Beacon procedure says two hands on the rail.",
          "line_id": "MS21_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "You only have one on it.",
          "line_id": "MS21_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "KIKIMO",
          "text": "I am doing the procedure for three people at present.",
          "line_id": "MS21_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Kikimo's report voice is immaculate until the beacon slips; then a small, very personal noise escapes. Waltz times a turn around the pulse. Tobile's floating head swivels independently toward the controls, with the source gap intact."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "WALTZ",
          "text": "You are early on the third beat.",
          "line_id": "MS21_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TOBILE",
          "text": "Third beat located. Apology preparing.",
          "line_id": "MS21_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "KIKIMO",
          "text": "Everybody stop being helpful at once.",
          "line_id": "MS21_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "KIKIMO",
          "text": "It used to guide us home.",
          "line_id": "MS21_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Now it thinks home means nobody gets in.",
          "line_id": "MS21_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "We need the beacon lit before the next dive.",
          "line_id": "MS21_IN_D09"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Preserve Kikimo's approved cadet design. Tobile's head remains visibly separated from the body exactly as in the game; frame the gap clearly instead of repairing it into a neck."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Restore each audited sky stop through Star Dock and Terrace Room. Free Waltz and Tobile, defeat Thunder Kite, then cleanse Storm Roc once the beacon can guide it. Recover Storm fragments and Wind Charm separately. The Roc's final wingbeat steadies a route instead of attacking it."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The rescue requires Kikimo to abandon the regulation position and trust someone else with the beacon. Their hand stays on it a moment after Rose offers."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "I have it.",
          "line_id": "MS21_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "KIKIMO",
          "text": "Confirm grip.",
          "line_id": "MS21_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "I have it.",
          "line_id": "MS21_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "This time Rose says it to the person rather than as a report. Kikimo releases. Tobile's overdrive is cleansed without changing the head-body separation; Waltz finds the steady beat through the Storm Roc's dive."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The scanner shows all six families represented, each still missing pieces. Kikimo fastens the beacon and looks toward the party's next route."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "KIKIMO",
          "text": "You have room for someone who knows which way is up?",
          "line_id": "MS21_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "We have been improvising.",
          "line_id": "MS21_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "We noticed.",
          "line_id": "MS21_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "KIKIMO",
          "text": "I deviated from procedure.",
          "line_id": "MS21_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "WALTZ",
          "text": "You stayed on the beat that mattered.",
          "line_id": "MS21_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TOBILE",
          "text": "Reboot complete. Tobile is your friend now.",
          "line_id": "MS21_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Was there a form?",
          "line_id": "MS21_OUT_D07"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TOBILE",
          "text": "Friendship form unavailable. Friendship still active.",
          "line_id": "MS21_OUT_D08"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Kikimo starts to write an exception, then puts the report away and asks who needs a hand down from the dock."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Register Kikimo, Waltz and Tobile according to earned availability. The expedition departs toward the archive with six incomplete families, not six finished cores."
        }
      ],
      "visual_direction": {
        "palette": "Exposed sky / clean silhouette rim",
        "framing": "Give Tobile a clear background so the floating head gap reads.",
        "sound": "Wind must not mask the beacon dialogue."
      },
      "baseline_shot_ids": [
        "MS21_A",
        "MS21_B",
        "MS21_C",
        "MS21_D",
        "MS21_E",
        "MS21_F"
      ],
