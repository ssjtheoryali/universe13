      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS21",
      "sequence": 21,
      "title": "The Sky Needs a Crew",
      "locations": [
        "Skyfall Isle",
        "Skyfall Cliffs",
        "Skyfall Village",
        "Wind Isle",
        "Sky Steps",
        "Sky Stones",
        "Sky Anchor",
        "Sky District",
        "Aerie City",
        "Star Dock",
        "Terrace Room"
      ],
      "opening": "Kikimo holds a drifting beacon. Storm Roc treats every visitor as an intruder.",
      "objective": "Cleanse Roc; recover Storm fragments and Wind Charm; free Waltz and Tobile; beat Thunder Kite; restore every sky stop to Star Dock and Terrace Room.",
      "outcome": "Kikimo joins. Six core families are represented but still incomplete.",
      "map_records": [
        "star_dock",
        "skyfall_isle",
        "wind_isle",
        "sky_stones",
        "save_skyfall_isle",
        "updraft_terraces",
