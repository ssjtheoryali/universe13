        "source_legacy_anchors": [
          "chapter_11"
        ],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS25",
      "sequence": 25,
      "title": "Who Has Been Watching",
      "locations": [
        "Signal Ridge",
        "Mountain Pass"
      ],
      "opening": "The relay exposes an organised route behind every extraction pulse.",
      "objective": "Defend relay, recover coordinates and protect restored anchors.",
      "outcome": "Remaining chains are located. The culprit stays unnamed and off-screen.",
      "map_records": [
        "signal_ridge",
        "save_signal_ridge",
        "chapter_12"
      ],
      "additional_records": [
        {
          "name": "SIGNAL RIDGE",
          "main_sequence": "MS25",
          "source": "game/js/world_v4.js"
        },
        {
          "name": "MOUNTAIN PASS",
          "main_sequence": "MS25",
          "source": "game/js/world_v4.js"
        }
      ],
      "legacy_anchors": [
        "chapter_12"
      ],
      "realm": "CHIBI / Signal Ridge",
      "character_turn": "Terra recognises a gesture, but lacks proof of its author.",
      "dialogue": "Terra: I need to be sure.",
      "expression_cues": "Terra: restrained dread; Ali: concern",
      "party_event": "none",
      "chapter": 5,
      "chapter_title": "Six Broken Lights",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS25_A",
          "sequence": "MS25",
          "cut_id": "MS25_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "The relay exposes an organised route behind every extraction pulse.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS25_B",
          "sequence": "MS25",
          "cut_id": "MS25_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Terra recognises a gesture, but lacks proof of its author.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS25_C",
          "sequence": "MS25",
          "cut_id": "MS25_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Terra: I need to be sure.",
          "performance_note": "Terra: restrained dread; Ali: concern; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS25_D",
          "sequence": "MS25",
          "cut_id": "MS25_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Defend relay, recover coordinates and protect restored anchors.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS25_E",
          "sequence": "MS25",
          "cut_id": "MS25_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Remaining chains are located. The culprit stays unnamed and off-screen.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        },
        {
          "shot_id": "MS25_F",
          "sequence": "MS25",
          "cut_id": "MS25_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into A Sanctuary Freely Held.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_5_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. EXTRACTION RELAY - NIGHT. Theory's remote overlay links pulse timings from every region. The lines converge on an organized command route. The operator remains absent: no identifiable shadow, voice, portrait or logo."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY, RADIO",
          "text": "The pulses share an instruction path.",
          "line_id": "MS25_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Somebody has been directing this.",
          "line_id": "MS25_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY, RADIO",
          "text": "The data says yes. I am sorry.",
          "line_id": "MS25_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Theory's apology is for the consequences, not an error. He is learning that accuracy does not remove the need to say the human thing. Terra recognizes the command structure and goes quiet, without identifying its source."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Terra?",
          "line_id": "MS25_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I am reading.",
          "line_id": "MS25_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY, RADIO",
          "text": "These were not separate accidents.",
          "line_id": "MS25_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Someone built the path.",
          "line_id": "MS25_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Then we break it without losing the addresses.",
          "line_id": "MS25_IN_D08"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Terra sees a command pattern and goes still, then deliberately returns to the rescue task. Do not name what she suspects or reveal a sibling through a flashback."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Defend the relay, preserve the consumed-particle records and reconnect the restored anchors before severing the active extraction route. A creature caught in the pulse is cleansed and released, demonstrating why indiscriminate destruction would harm the stolen matter."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Terra rechecks a connector she has already seated. Ali gently sets a second tool beside it instead of prying. She notices he has learned to offer help without taking the job away."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "What if knowing how something works does not help you stop it?",
          "line_id": "MS25_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Then you do not work on it alone.",
          "line_id": "MS25_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "You make that sound very easy.",
          "line_id": "MS25_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "I have been practicing saying it. Doing it is worse.",
          "line_id": "MS25_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "She lets him hold the connector while she checks the address record. No source-identifying gesture, childhood object or secret villain voice leaks the reveal."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Remaining chains resolve on the scanner. The sealed workstation appears as a destination with no personal identifier."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "We have the places. We still need the person to stop.",
          "line_id": "MS25_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "First we keep these places safe.",
          "line_id": "MS25_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "We can take a minute.",
          "line_id": "MS25_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "No. If I stop now, I will start making reasons.",
          "line_id": "MS25_OUT_D04"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Rose hears the difference between a technical answer and a frightened one. She does not force Terra to confess before the scene has earned it."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Then I stay beside you.",
          "line_id": "MS25_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Preserve the culprit blackout through the end of MS27. The next branch is the sanctuary's emergency signal."
        }
      ],
      "visual_direction": {
        "palette": "Night relay / discrete extraction pulses",
        "framing": "No shot, shadow or reflection identifies Pixel here.",
        "sound": "Nonverbal machinery only; no disguised villain voice."
      },
      "baseline_shot_ids": [
        "MS25_A",
        "MS25_B",
        "MS25_C",
        "MS25_D",
        "MS25_E",
        "MS25_F"
      ],
