    },
    {
      "id": "MS40",
      "sequence": 40,
      "title": "Home, With a Way Back",
      "locations": [
        "Heart Village",
        "restored settlements",
        "all recruited allies"
      ],
      "opening": "Revisit repaired markets, water and sanctuaries. Terra's place remains empty.",
      "objective": "Complete homecoming and choose postgame travel. Visits do not reopen uncontrolled rifts.",
      "outcome": "Season 1 resolves: particles returned, six cores restored, Pixel stopped, Ali and Rose home, worlds free. Manga Juevy and Pixel's hidden history wait for later.",
      "map_records": [],
      "additional_records": [],
      "legacy_anchors": [],
      "realm": "REAL and CHIBI / Epilogue",
      "character_turn": "Ali and Rose cross into their own reality. Their Chibi companions say goodbye at the far side of the stable gate, rather than all appearing as residents of the real world.",
      "dialogue": "Rose: Home. And now we know the way back.",
      "expression_cues": "Ali and Rose: relief, gratitude, grief; companions: farewell",
      "party_event": "home:Ali,Ivy",
      "chapter": 8,
      "chapter_title": "Home, With a Way Back",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
