        "requires": "MS32_objective_complete",
        "quest_flag_is_proposed_binding": true,
        "source_legacy_anchors": [
          "chapter_19"
        ],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS33",
      "sequence": 33,
      "title": "Ali Ski, Meet Ali Ski",
      "locations": [
        "Dragon Shrine",
        "Archive",
        "Reality Gate"
      ],
      "opening": "At the gate archive, realistic Ali and Chibi Ali step into the same light, point at each other and simultaneously say: Ali Ski. Each waits for the other to explain.",
      "objective": "After the comic introduction, calibrate the homeward archive with Chibi Ali's local route map and Rose's reality signature. This meeting is mandatory main-story content, not an optional cameo.",
      "outcome": "Chibi Ali supplies the local route half the travellers lacked. The archive isolates Ali and Rose's own reality; the gate still needs the lunar engine stopped and six cores reassembled. Both Alis finish the fist bump at the same height.",
      "map_records": [
        "dragon_shrine",
        "save_dragon_shrine",
        "chapter_20"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_20"
      ],
      "realm": "CHIBI / Gate Archive",
      "character_turn": "They copy the same suspicious head tilt, then attempt a fist bump at mismatched heights. Ali crouches just as Chibi Ali steps onto a crate, missing again. Rose watches both with affectionate disbelief.",
      "dialogue": "BOTH ALIS: No, I'm Ali Ski. ROSE: Twice the Ali. Still one way home. CHIBI ALI: Good thing I brought a map.",
      "expression_cues": "Both Alis: suspicious mirroring, mock offence, comic timing, mutual delight; Rose: dry amusement to hopeful focus",
      "party_event": "none",
      "chapter": 7,
      "chapter_title": "The Place Terra Held",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS33_A",
          "sequence": "MS33",
          "cut_id": "MS33_IN",
          "camera": "Wide two-shot / simultaneous introduction",
          "action": "At the gate archive, realistic Ali and Chibi Ali step into the same light, point at each other and simultaneously say: Ali Ski. Each waits for the other to explain.",
          "performance_note": "Hold the height contrast without resizing either Ali; both point and speak together. Rose gives a silent blink.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS33_B",
          "sequence": "MS33",
          "cut_id": "MS33_IN",
          "camera": "Medium mirrored head tilts / matched eyelines",
          "action": "Both inspect the matching masks and say I look good at the same moment. Each reacts as if the other stole his line.",
          "performance_note": "Small pauses and exact head-tilt timing; neither is a fake or a transformation.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS33_C",
          "sequence": "MS33",
          "cut_id": "MS33_IN",
          "camera": "Full-body wide / double missed fist bump",
          "action": "They copy the same suspicious head tilt, then attempt a fist bump at mismatched heights. Ali crouches just as Chibi Ali steps onto a crate, missing again. Rose watches both with affectionate disbelief.",
          "performance_note": "Ali crouches as Chibi Ali steps onto a crate; miss twice, hold, then Rose: Neither of you came with a map. Chibi Ali raises his scanner: Good thing I brought one.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS33_D",
          "sequence": "MS33",
          "cut_id": "MS33_BRIDGE",
          "camera": "Readable archive calibration / route closeup",
          "action": "After the comic introduction, calibrate the homeward archive with Chibi Ali's local route map and Rose's reality signature. This meeting is mandatory main-story content, not an optional cameo.",
          "performance_note": "Movie shows Chibi map plus Rose reality signature resolving the home window. Game hands control to the same main quest after the comic dialogue.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS33_E",
          "sequence": "MS33",
          "cut_id": "MS33_OUT",
          "camera": "Matched route display / hope reaction",
          "action": "Chibi Ali supplies the local route half the travellers lacked. The archive isolates Ali and Rose's own reality; the gate still needs the lunar engine stopped and six cores reassembled. Both Alis finish the fist bump at the same height.",
          "performance_note": "Rose identifies their own reality, distinct from the Chibi skyline; six core outlines remain incomplete.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        },
        {
          "shot_id": "MS33_F",
          "sequence": "MS33",
          "cut_id": "MS33_OUT",
          "camera": "Wide fist-bump payoff / travel transition",
          "action": "Both Alis agree the height and finally land the fist bump. Rose: One route. Let us keep it that way. Cut toward lunar preparation.",
          "performance_note": "Both are competent and amused; no unmasking, no random human spectators, no repeated gag over Terra loss.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_7_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. GATE ARCHIVE - DAY. The ground siphon has stopped. The lunar threat remains on the distant monitor. Realistic Ali and masked Rose enter the archive carrying the verified return signatures. Chibi Ali is already at the local route table, moving a marker away from a damaged crossing. He has his own work in his own world. No crowd is assembled to watch the visitors."
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "1. SAME NAME. Chibi Ali turns. Realistic Ali stops in exactly the same pool of light. Tall and small, both hold the other's attention. The red masks and varsity silhouettes rhyme without changing either body's proportions. Each points at the other."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "Ali Ski.",
          "line_id": "MS33_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI",
          "text": "Ali Ski.",
          "line_id": "MS33_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "BOTH",
          "text": "No, I'm Ali Ski.",
          "line_id": "MS33_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Rose gives one silent blink. Neither Ali wants to be the one who needs the explanation. They each look at Rose as though she has brought the wrong person."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Yes. I heard both of you.",
          "line_id": "MS33_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "He said it at the same time.",
          "line_id": "MS33_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI",
          "text": "So did he.",
          "line_id": "MS33_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Remarkably, I heard that too.",
          "line_id": "MS33_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "2. THE INSPECTION. The two Alis circle half a step, keeping the route table between their hands. They tilt their heads in perfect accidental sync and glance at the familiar red masks and varsity looks."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "I look good.",
          "line_id": "MS33_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI, SIMULTANEOUS",
          "text": "I look good.",
          "line_id": "MS33_IN_D09"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Both straighten as though the other stole the line. Chibi Ali looks at the visitor's boots, then at the lintel over the door. The height assessment is openly theatrical; his own size is never treated as a defect."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI",
          "text": "Roads smaller where you come from?",
          "line_id": "MS33_IN_D10"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "Doorways are doing their best here.",
          "line_id": "MS33_IN_D11"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "The archive.",
          "line_id": "MS33_IN_D12"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Neither moves quite yet. Ali glances at the marker Chibi Ali was placing when they entered."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "You were fixing that route?",
          "line_id": "MS33_IN_D13"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI",
          "text": "Somebody has to tell people which bridge is still a bridge.",
          "line_id": "MS33_IN_D14"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "REAL ALI",
          "text": "I have been learning that.",
          "line_id": "MS33_IN_D15"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "CHIBI ALI",
          "text": "Slowly?",
          "line_id": "MS33_IN_D16"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "He has been learning.",
          "line_id": "MS33_IN_D17"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "3. THE FIRST MISSED FIST BUMP. Real Ali offers his fist at his own relaxed height. Chibi Ali reaches up. Both are perfectly certain the other will make the adjustment. Their fists pass at different levels. Hold the honest wide shot; do not cut to separate hands to fake contact."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "They look at the gap. Real Ali begins to crouch at the same instant Chibi Ali steps onto a low crate."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "4. THE SECOND MISS. Their heights reverse. They miss a second time, then freeze. Both inspect their own hands like the equipment malfunctioned. Rose waits through one full look from each of them before speaking."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "You come with a ladder?",
          "line_id": "MS33_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "REAL ALI",
          "text": "You come with instructions?",
          "line_id": "MS33_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Neither of you came with a map.",
          "line_id": "MS33_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "5. THE MAP. Chibi Ali silently raises his local route scanner. His patience is unbearable. Rose recognizes what it contains one beat before the visitor does."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "Good thing I brought one.",
          "line_id": "MS33_BRIDGE_D04"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "REAL ALI",
          "text": "You waited for that.",
          "line_id": "MS33_BRIDGE_D05"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "I have been very patient with you.",
          "line_id": "MS33_BRIDGE_D06"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "He has the route. Please survive being impressed.",
          "line_id": "MS33_BRIDGE_D07"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Chibi Ali gets down from the crate and returns to the table. The performance drops away as he works. He docks the map he was already maintaining, not a magical item created for this meeting. Real Ali kneels to see the actual markings rather than leaning across and obscuring them."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "Mine gets you to the door. Yours tells it where you belong.",
          "line_id": "MS33_BRIDGE_D08"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Two travellers. Same origin. Keep both records.",
          "line_id": "MS33_BRIDGE_D09"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Rose supplies her signature and Ali's. Chibi Ali holds the local route steady while she verifies the two origin addresses. Local knowledge and the visitors' evidence do different necessary jobs. Neither alone could complete this calibration."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "REAL ALI",
          "text": "This one?",
          "line_id": "MS33_BRIDGE_D10"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Wait.",
          "line_id": "MS33_BRIDGE_D11"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "He takes his hand away from the control and waits. Rose checks the return, then looks at Chibi Ali rather than assuming permission to alter his map."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Ready on your side?",
          "line_id": "MS33_BRIDGE_D12"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "CHIBI ALI",
          "text": "Ready.",
          "line_id": "MS33_BRIDGE_D13"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "She confirms the route. The archive isolates a home window separate from the Chibi skyline. The cores do not complete themselves, the lunar engine does not stop, and no other world becomes a substitute home."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "6. THE QUIET PART. Their actual reality resolves in the window. The two visitors stand very still. Rose searches the address once more, then lets herself recognize what is beyond it."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "There. Our reality.",
          "line_id": "MS33_OUT_D01"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Real Ali's swagger leaves his shoulders. He does not need to make the feeling look impressive. Chibi Ali watches the change and chooses not to fill the silence with another joke."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "CHIBI ALI",
          "text": "You have been looking a while.",
          "line_id": "MS33_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "REAL ALI",
          "text": "Yeah.",
          "line_id": "MS33_OUT_D03"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Chibi Ali glances back at the route marker he was moving before they arrived. The audience can see both kinds of belonging in the same frame: two people trying to leave, one person keeping his own place usable."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "CHIBI ALI",
          "text": "Well. Now you know which way to look.",
          "line_id": "MS33_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "REAL ALI",
          "text": "You got us closer.",
          "line_id": "MS33_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "CHIBI ALI",
          "text": "Obviously. I'm Ali Ski.",
          "line_id": "MS33_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The joke returns after the feeling has landed. Real Ali's laugh reaches his eyes. Rose lets the two of them have the moment without issuing another instruction."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "7. THE SUCCESSFUL BUMP. They start to offer their fists again, stop themselves, then agree a height with a small upward/downward negotiation. Real Ali holds his hand where they agreed. Chibi Ali stays on the floor. The fist bump lands cleanly. Both laugh through eyes, shoulders and breath; both masks stay on."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "One route. Let's keep it that way.",
          "line_id": "MS33_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Keep the entire encounter on the mandatory main route after MS32 and before MS34. In the game, the player performs the address calibration between the introduction and earned OUT; film BRIDGE performs the same successful task. Do not replay either missed bump or the successful bump a second time. Carry the isolated home address into launch preparation. The first-try MS40 farewell bump pays off the height they learned here."
        }
      ],
      "visual_direction": {
        "palette": "Warm archive / clean comic silhouettes",
        "framing": "Wide holds both missed bumps; one silent Rose blink.",
        "sound": "No vocal music; pauses carry the punchlines."
      },
      "baseline_shot_ids": [
        "MS33_A",
        "MS33_B",
        "MS33_C",
        "MS33_D",
        "MS33_E",
        "MS33_F"
      ],
      "gameplay_entry": {
        "cut": "MS33_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
      "gameplay_exit": {
        "cut": "MS33_OUT",
        "requires": "MS33_objective_complete",
        "quest_flag_is_proposed_binding": true,
        "source_legacy_anchors": [
          "chapter_20"
        ],
        "replay_read_only": true
      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS34",
