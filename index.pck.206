      ],
      "opening": "Terra installs a repair coupler beside Juevy Jet combat systems.",
      "objective": "Complete proving ground and upgrades; preserve original jet-to-mech form, distinct from La Catrina.",
      "outcome": "Launch with saved party snapshot and a clear backup rescue crew.",
      "map_records": [
        "mech_oasis",
