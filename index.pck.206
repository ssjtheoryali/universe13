      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS09",
      "sequence": 9,
      "title": "A City Under a City",
      "locations": [
        "Breathing Chamber",
        "City Square",
        "Main Street",
        "Collapsed Subway",
        "Service Tunnels",
        "Old Shrine",
        "Pump Station",
        "Flooded Vault"
      ],
      "opening": "Beneath the city, Ali and Rose find an old district recording labelled BEFORE THE CALAMITY: giant Chibi Noki calmly steadies a bridge for tiny Chibi travellers and native creatures.",
      "objective": "Trace Noki's local peacekeeping route through the square, shrine, tunnels, pump station and flooded vault to recover the return-anchor signal Ali and Rose need for their reality.",
      "outcome": "The same steadying hand seen in the peaceful recording now trembles under rift corruption. Ali and Rose understand that restoring this world's guardian is the way forward, not defeating a copy of someone from home.",
      "map_records": [
        "breathing_chamber",
        "chapter_07",
        "light_breathing"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_07"
      ],
      "realm": "CHIBI / Breathing Chamber",
      "character_turn": "Chibi Juevy explains that this is their Noki, the district's familiar peacekeeper, with a life and responsibilities of his own. The recording ends before the crew hears the present-day distress pulse.",
      "dialogue": "ALI: Giant Noki? CHIBI JUEVY: Our Noki. He keeps the peace. ROSE: Different world. Different life.",
      "expression_cues": "Ali: curiosity to understanding; Rose: attentive empathy; Juevy: local pride becoming concern",
      "party_event": "none",
      "chapter": 2,
      "chapter_title": "The Masked Rose",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
