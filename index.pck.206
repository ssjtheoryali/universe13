        "Shockwave Plaza"
      ],
      "opening": "Giant Chibi Noki still tries his familiar protective gesture, bracing a shelter exactly as he steadied the bridge in the old recording. Rift pulses jerk the same black spiky armour and green visor out of control.",
      "objective": "Use the remembered peacekeeping gesture to reach safe zones, quiet the corrupt pulse and recover the next homeward signal. Preserve Noki and the sparse local Chibi residents; do not kill the guardian.",
      "outcome": "Noki briefly recognises the local crew and steadies the escape path before the corruption pulls him away. Freeing him will reopen the return anchor Ali and Rose need.",
      "map_records": [
        "kaiju_district",
        "save_kaiju_district",
        "chapter_02",
        "chapter_08",
        "beat_static_first",
        "post_kaiju"
      ],
      "additional_records": [],
