    },
    {
      "id": "MS16",
      "sequence": 16,
      "title": "More Than One World",
      "locations": [
        "West Lagoons",
        "Overpass 13",
        "Sea Arch West",
        "Lagoon Shrine",
        "Lagoon Palms"
      ],
      "opening": "A tracking shot crosses Sea Arch West into a different coastline with incompatible signatures.",
      "objective": "Restore Lagoon Shrine and Overpass 13; escort travellers and tag universe-of-origin coordinates.",
      "outcome": "The expedition names the multiverse. Repair will preserve distinct worlds.",
      "map_records": [
        "shrine_lagoon",
        "sea_arch_west"
      ],
      "additional_records": [
        {
          "id": "lagoon_palms",
          "name": "LAGOON PALMS",
