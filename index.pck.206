    },
    {
      "id": "MS14",
      "sequence": 14,
      "title": "A Caravan That Cannot Leave",
      "locations": [
        "Sunsand Outpost",
        "Sunsand Bazaar",
        "Dune Sea",
        "Wastes Canyon Run",
        "Dune Room"
      ],
      "opening": "Sand Wyrm circles a caravan inside an endless dune ring.",
      "objective": "Escort outpost and bazaar residents; cleanse Wyrm; recover Dune fragments and Scarab Hook; beat Khan and free Dixie.",
