        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. ENCORE CITY THEATRE - EVENING. Mister Smiles bows to empty seats. The colour drains from the city on every forced encore. A surviving resident closes their eyes before the cue."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "MISTER SMILES",
          "text": "There you are. Front row. No leaving during the good part.",
          "line_id": "MS22_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Which part is that?",
          "line_id": "MS22_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "MISTER SMILES",
          "text": "The part where you look at me.",
          "line_id": "MS22_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Smiles waits for a laugh and adjusts his bow when none comes. A Chibi resident instinctively claps to prevent his anger. He spots the frightened applause and accepts it anyway."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "MISTER SMILES",
          "text": "Better. We can teach the rest.",
          "line_id": "MS22_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "MISTER SMILES",
          "text": "Again. They liked it the first time.",
          "line_id": "MS22_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Then let them choose a second.",
          "line_id": "MS22_IN_D06"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "The party sees an archive route behind the stage, pulsing in time with the applause. The target is the enforced loop, not a resident who refuses to laugh."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Break the encore mechanism, restore the chasm route and recover the archive. The film moves the action through the actual city stops, not an unrelated arena. Defeating Smiles releases routed fragments and coordinate records; no seventh Power Core appears."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Smiles turns the stage light away from the city each time someone else draws attention. Ali begins to offer himself as the spectacle; Rose shakes her head."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "He does not need a bigger rival.",
          "line_id": "MS22_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "He needs an audience that can leave.",
          "line_id": "MS22_BRIDGE_D02"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Ali steps out of the spotlight and opens the exit. Residents take their own moment to move. Smiles' attack tries to pull every face back toward him."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "MISTER SMILES",
          "text": "You are missing it!",
          "line_id": "MS22_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "We have seen it.",
          "line_id": "MS22_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Colour returns unevenly as residents begin moving for themselves. One applauds a neighbour helping them stand. Others join without a cue."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "There. That is an audience.",
          "line_id": "MS22_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Nobody told them when.",
          "line_id": "MS22_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "What does the archive say?",
          "line_id": "MS22_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "Where the missing pieces went.",
          "line_id": "MS22_OUT_D04"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "A resident helps another stand, and somebody applauds them. Smiles looks toward the sound. It is the first applause in the scene that has nothing to do with him."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Let it be theirs.",
          "line_id": "MS22_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Nobody asks the residents to forgive him as the price of getting their colour back. Rose closes the archive case while the local celebration begins without a stage manager."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "The six-family ledger highlights remaining chains and already visited streets. Take the next route back to the first Chibi city."
        }
      ],
      "visual_direction": {
        "palette": "Drained stage / returning local colour",
        "framing": "Empty seat axis opens to residents applauding each other.",
        "sound": "Forced encore becomes chosen applause without playback cue."
      },
