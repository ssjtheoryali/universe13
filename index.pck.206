‘ø&o,“]OlÃ>uQa;oÀXÏ'{!é=½ÓƒVª³½âimæ␀// UNIVERSE 13 Â· the ground. Real surfaces per biome (Poly Haven CC0 textures), rock on every steep face
// (triplanar, so cliffs never stretch), and a large-scale layer that hides the tiling.
// Weights come in per vertex: COLOR = grass, sandstone, gravel, ash Â· CUSTOM0 = sand, rock, snow, wet sand.
shader_type spatial;
render_mode cull_back, diffuse_burley;

uniform sampler2D t_grass : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_sandstone : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_gravel : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_ash : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_sand : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_rock : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D t_snow : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_grass : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_rock : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D n_sand : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float scale = 0.22;
uniform vec3 grass_tint : source_color = vec3(0.86, 1.0, 0.78);
uniform vec3 crystal_tint : source_color = vec3(0.72, 0.86, 1.0);

varying vec3 wpos;
varying vec3 wnorm;
varying vec4 wb;

void vertex() {
	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	wnorm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
	wb = CUSTOM0;
}

vec3 anti_tile(sampler2D t, vec2 uv) {   // near detail mixed with a big, rotated copy: no visible grid of repeats
	vec3 a = texture(t, uv).rgb;
	vec2 r = mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8)) * uv * 0.19;
	vec3 b = texture(t, r).rgb;
	return mix(a, b, 0.38);
}

vec3 tri(sampler2D t, vec3 p, vec3 n) {
	vec3 w = pow(abs(n), vec3(4.0)); w /= (w.x + w.y + w.z);
	return texture(t, p.zy).rgb * w.x + texture(t, p.xz).rgb * w.y + texture(t, p.xy).rgb * w.z;
}

void fragment() {
	vec2 uv = wpos.xz * scale;
	vec4 wa = COLOR;
	float total = wa.r + wa.g + wa.b + wa.a + wb.r + wb.g + wb.b + wb.a + 0.0001;
	// only the surfaces actually present here are sampled (usually one or two): keeps this laptop's GPU fast
	vec3 col = vec3(0.0);
	if (wa.r > 0.01) col += anti_tile(t_grass, uv) * grass_tint * wa.r;
	if (wa.g > 0.01) col += anti_tile(t_sandstone, uv * 0.7) * wa.g;
	if (wa.b > 0.01) col += anti_tile(t_gravel, uv) * crystal_tint * wa.b;
	if (wa.a > 0.01) col += anti_tile(t_ash, uv * 0.8) * wa.a;
	if (wb.r > 0.01) col += anti_tile(t_sand, uv * 0.8) * wb.r;
	if (wb.g > 0.01) col += anti_tile(t_rock, uv * 0.6) * wb.g;
	if (wb.b > 0.01) col += anti_tile(t_snow, uv * 0.7) * wb.b;
	if (wb.a > 0.01) col += anti_tile(t_sand, uv * 0.8) * vec3(0.62, 0.66, 0.66) * wb.a;
	col /= total;
	// steep faces are bare rock (not on snow caps)
	float steep = 1.0 - smoothstep(0.52, 0.78, wnorm.y);
	if (steep > 0.01) col = mix(col, tri(t_rock, wpos * scale * 0.55, wnorm) * vec3(0.95, 0.92, 0.88), steep * (1.0 - wb.b * 0.5));
	ALBEDO = col;
	ROUGHNESS = mix(0.93, 0.85, wb.a);
	vec3 nm = (wb.r + wb.a > 0.5) ? texture(n_sand, uv * 0.8).rgb : texture(n_grass, uv).rgb;
	if (steep > 0.01) nm = mix(nm, texture(n_rock, uv * 0.6).rgb, steep);
	NORMAL_MAP = nm;
	NORMAL_MAP_DEPTH = 0.9;
