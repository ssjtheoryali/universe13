      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS11",
      "sequence": 11,
      "title": "The Current Beneath the Static",
      "locations": [
        "Ultimate HQ",
        "Theory Lab",
        "Archive"
      ],
      "opening": "Theory compares the chamber pulse, Noki's heartbeat and the first fragment.",
      "objective": "Defend the lab, compare samples and tag correct origin coordinates.",
      "outcome": "Six incomplete core outlines appear. No Pixel name, face, voice or identifying emblem.",
      "map_records": [
        "chapter_09"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_09"
      ],
      "realm": "CHIBI / HQ",
      "character_turn": "Particles are being consumed; unanchored repairs feed extraction.",
      "dialogue": "Theory: Send it where it belongs.",
      "expression_cues": "Theory: discovery and concern; Ali: resolve",
      "party_event": "introduce:Theory",
      "chapter": 3,
      "chapter_title": "The Desire Inside the Monster",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS11_A",
          "sequence": "MS11",
          "cut_id": "MS11_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Theory compares the chamber pulse, Noki's heartbeat and the first fragment.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS11_B",
          "sequence": "MS11",
          "cut_id": "MS11_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Particles are being consumed; unanchored repairs feed extraction.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS11_C",
          "sequence": "MS11",
          "cut_id": "MS11_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Theory: Send it where it belongs.",
          "performance_note": "Theory: discovery and concern; Ali: resolve; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS11_D",
          "sequence": "MS11",
          "cut_id": "MS11_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Defend the lab, compare samples and tag correct origin coordinates.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS11_E",
          "sequence": "MS11",
          "cut_id": "MS11_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "Six incomplete core outlines appear. No Pixel name, face, voice or identifying emblem.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS11_F",
          "sequence": "MS11",
          "cut_id": "MS11_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: introduce:Theory. Carry the eyeline into The Roads That Recruit.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "INT. THEORY'S LAB - NIGHT. Three traces share a monitor: the chamber pulse, Noki's rhythm and the recovered fragment. Theory shifts one trace until the theft and the involuntary movement line up."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "Do not touch the marked sample.",
          "line_id": "MS11_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "The one that is glowing?",
          "line_id": "MS11_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "The one marked DO NOT TOUCH.",
          "line_id": "MS11_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "For the record, your handwriting glows.",
          "line_id": "MS11_IN_D04"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Theory turns the container so the label faces Ali. The irritation is real but brief; he has been working too long and straightens the same instrument twice."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "How long since you rested?",
          "line_id": "MS11_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "I have had several unproductive hours. I do not need more.",
          "line_id": "MS11_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "That was not the question.",
          "line_id": "MS11_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "The same pulse is moving matter and overriding movement.",
          "line_id": "MS11_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "So stopping it could free him.",
          "line_id": "MS11_IN_D09"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "If we return the matter to its actual address.",
          "line_id": "MS11_IN_D10"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Ali touches his return marker to the scanner. The device rejects the Chibi location. Theory does not override the warning."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Close is not home.",
          "line_id": "MS11_IN_D11"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "THEORY",
          "text": "Correct. A similar sky is still the wrong sky.",
          "line_id": "MS11_IN_D12"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Defend the lab from corrupted creatures while Theory compares the samples. Tag the origin coordinates before reconnecting the scanner. The film version shows the same successful tasks; it must not imply that combat alone solves the address problem."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "An alarm sounds during comparison. Theory starts the measurement again rather than using the questionable result. Ali bristles at the lost seconds."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "We had a direction.",
          "line_id": "MS11_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "THEORY",
          "text": "We had a number that looked agreeable.",
          "line_id": "MS11_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "What happens if we use it?",
          "line_id": "MS11_BRIDGE_D03"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "THEORY",
          "text": "Best case, nothing. The other case has people in it.",
          "line_id": "MS11_BRIDGE_D04"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Ali looks at the return markers. He covers the scanner while Theory repeats the test."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Then take the seconds.",
          "line_id": "MS11_BRIDGE_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Six incomplete outlines appear, each with many missing fragments. A separate relic list stays on a different display. No seventh outline, hidden culprit portrait, voice or identifying emblem."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Six cores. All broken.",
          "line_id": "MS11_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Then six things to put back together.",
          "line_id": "MS11_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "And every place those pieces came from.",
          "line_id": "MS11_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY",
          "text": "Six families. Many missing fragments. I will not call a piece a core because we are tired.",
          "line_id": "MS11_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "JUEVY",
          "text": "Could you call a break a break?",
          "line_id": "MS11_OUT_D05"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Theory begins to refuse. Rose sets his cup where his hand already rests. He takes it without noticing until the others stop talking."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY",
          "text": "Ten minutes.",
          "line_id": "MS11_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Excellent. You can tell us what we got wrong after.",
          "line_id": "MS11_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Theory becomes a named support contact now; the later field unlock still requires its source-game gate. The scanner identifies connected regional roads."
        }
      ],
      "visual_direction": {
        "palette": "Lab neutral / six restrained family colours",
        "framing": "Read six outlines and a separate relic screen in one insert.",
        "sound": "Lab hum leaves space for address verification."
      },
      "baseline_shot_ids": [
        "MS11_A",
        "MS11_B",
        "MS11_C",
