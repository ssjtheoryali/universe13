          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS30_C",
          "sequence": "MS30",
          "cut_id": "MS30_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Tell me your name.",
          "performance_note": "Ali: frightened focus; companion: tenderness; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS30_D",
          "sequence": "MS30",
          "cut_id": "MS30_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Restore streets and void-citadel records; rebuild return addresses, not substitute people.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS30_E",
          "sequence": "MS30",
          "cut_id": "MS30_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The final chain points inside Noki; his rescue is possible.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS30_F",
          "sequence": "MS30",
          "cut_id": "MS30_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: none. Carry the eyeline into Noki's Own Heartbeat.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. FADING STREETS - PREDAWN. Door names disappear before the doors themselves. A local resident points to a blank plaque, frightened by their own uncertainty. Ali opens the earlier route log."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Heartmere shelter. Left turn by the broken--",
          "line_id": "MS30_IN_D01"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "The familiar plaque is blank. A local resident stares at it as though embarrassed not to know their own address. Ali stops treating the record as a test they are failing."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "We came through here. Terra hated that beam.",
          "line_id": "MS30_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "I hated whoever called it repaired.",
          "line_id": "MS30_IN_D03"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "Juevy counted to three. I ignored him.",
          "line_id": "MS30_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "History should preserve that part.",
          "line_id": "MS30_IN_D05"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "The resident recognizes the place through a lived encounter before the official address returns. Recognition and actual particle records work together; neither manufactures a duplicate person."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "We wrote it down.",
          "line_id": "MS30_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Read it back. The address first.",
          "line_id": "MS30_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Use names and addresses already present in source records when voiced; never fill the scene with newly invented mandatory NPC identities. The resident's relief is performed through the return of recognition."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Restore the streets and void-citadel records. Recover each original return address before reconnecting its anchor. The film pairs an earlier saved location image with its present restoration; do not create duplicate people from recollection or imply memory alone is a substitute for matter."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Rose's own home marker briefly blanks. She goes perfectly still. Ali sees her thumb press the control twice, the habit he learned while separated."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "Here. Use mine.",
          "line_id": "MS30_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ROSE",
          "text": "Yours is not a backup for mine.",
          "line_id": "MS30_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "I know. It is a hand while you get yours back.",
          "line_id": "MS30_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "She accepts the support without surrendering her own record. The shared scanner confirms both distinct signatures."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The last record points to extraction roots inside Noki. His own rhythm remains beneath the command pulse."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "That heartbeat is still his.",
          "line_id": "MS30_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "We promised we would come back.",
          "line_id": "MS30_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "This time we know what to remove.",
          "line_id": "MS30_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Your hands are shaking.",
          "line_id": "MS30_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "They have been doing that. Usually where nobody can see.",
          "line_id": "MS30_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "Does it help?",
          "line_id": "MS30_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "It makes the reports shorter.",
          "line_id": "MS30_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Terra does not laugh at the confession. She offers her own unsteady hand beside Rose's, then returns to work with her."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "Noki's rhythm is still there.",
          "line_id": "MS30_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Then that promise still has somebody to go to.",
          "line_id": "MS30_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Carry the correct coordinates and cleansing method into the ascent. Establish that rescue remains possible before the large action sequence."
        }
      ],
      "visual_direction": {
        "palette": "Fading dawn / returning street names",
        "framing": "Match earlier location records to real restored matter.",
        "sound": "Lost address syllables return with the record."
      },
      "baseline_shot_ids": [
        "MS30_A",
        "MS30_B",
        "MS30_C",
