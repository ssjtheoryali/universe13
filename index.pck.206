    },
    {
      "id": "MS27",
      "sequence": 27,
      "title": "Two Cities, One Crossing",
      "locations": [
        "Wish Bridge",
        "Auravex",
        "Auravex North",
        "Auravex South",
        "Auravex West",
        "Auravex East",
        "Suncrown North",
        "Suncrown South",
        "Suncrown West",
        "Suncrown East",
        "City Gate",
        "Suncrown Gate",
        "Rim Pass"
      ],
      "opening": "The journey connects two distinct cities through damaged approaches.",
      "objective": "Visit all assigned quarters, reopen gates, escort residents and break bridge chain.",
      "outcome": "The crossing restores the final path to the sealed workstation. HQ calls the party home.",
      "map_records": [
        "wish_bridge",
        "chapter_14",
        "chasm_city"
      ],
      "additional_records": [],
      "legacy_anchors": [
        "chapter_14"
      ],
      "realm": "CHIBI / Auravex and Suncrown",
      "character_turn": "Earned allies coordinate supplies; ensemble inserts adapt to the recruited roster.",
      "dialogue": "Ali: Nobody gets left between them.",
      "expression_cues": "Ali: leadership; ensemble: cooperation",
      "party_event": "return:local_support",
      "chapter": 6,
      "chapter_title": "Order Without Consent",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS27_A",
          "sequence": "MS27",
          "cut_id": "MS27_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "The journey connects two distinct cities through damaged approaches.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS27_B",
          "sequence": "MS27",
          "cut_id": "MS27_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Earned allies coordinate supplies; ensemble inserts adapt to the recruited roster.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS27_C",
          "sequence": "MS27",
          "cut_id": "MS27_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Nobody gets left between them.",
          "performance_note": "Ali: leadership; ensemble: cooperation; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS27_D",
          "sequence": "MS27",
          "cut_id": "MS27_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Visit all assigned quarters, reopen gates, escort residents and break bridge chain.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS27_E",
          "sequence": "MS27",
          "cut_id": "MS27_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The crossing restores the final path to the sealed workstation. HQ calls the party home.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        },
        {
          "shot_id": "MS27_F",
          "sequence": "MS27",
          "cut_id": "MS27_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: return:local_support. Carry the eyeline into The Name Behind the Damage.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_6_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. TWO-CITY APPROACHES - DAWN. The road connects two damaged cities with different materials and customs. Residents on each side work toward the same broken gate."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "They used to argue about whose road this was.",
          "line_id": "MS27_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "And now?",
          "line_id": "MS27_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Now they argue about who gets to repair it first. Progress.",
          "line_id": "MS27_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Two local work groups try to lift the same support. They get in each other's way, stop, and work out a count. The community has friction after rescue; it has not become a grateful chorus."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "Let them find it.",
          "line_id": "MS27_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I was not going to count.",
          "line_id": "MS27_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "You were breathing in.",
          "line_id": "MS27_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "They have never shared a road before.",
          "line_id": "MS27_IN_D07"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "JUEVY",
          "text": "Roads have to start somewhere.",
          "line_id": "MS27_IN_D08"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ROSE",
          "text": "As long as both sides get to choose where they go.",
          "line_id": "MS27_IN_D09"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "The returned support ally joins the actual selected crew at the approach. Avoid a fixed lineup containing every recruit."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Visit every assigned quarter, reopen the gates, escort residents and break the bridge chain. Each quarter contributes a visible piece of the crossing rather than a disconnected detour. Finish all required approaches before unlocking the sealed workstation route."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The returned support ally comes back tired, carrying a repaired everyday item from the place they helped. The field crew makes room without demanding a retelling before allowing rest."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "Saved you a seat.",
          "line_id": "MS27_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "He sat in it.",
          "line_id": "MS27_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "JUEVY",
          "text": "Kept it warm.",
          "line_id": "MS27_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "The joke is an invitation back into familiar company. The restored bridge takes their combined weight without a pulse."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The road holds across both cities. HQ calls; the camera stays with the repaired world rather than cutting to an unseen villain."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "The workstation route is open. Come home to the scanner.",
          "line_id": "MS27_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "On our way.",
          "line_id": "MS27_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "The workstation is reachable. I checked it twice.",
          "line_id": "MS27_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "And rested once?",
          "line_id": "MS27_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "THEORY, RADIO",
          "text": "That was an extremely specific condition.",
          "line_id": "MS27_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "We are on our way.",
          "line_id": "MS27_OUT_D06"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "Terra's answer arrives too quickly. Juevy looks at her, sees she does not want to be asked again, and walks beside her rather than ahead."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "End the blackout here. The next sequence is the first time the audience will see or hear the canon Season 1 Pixel."
        }
      ],
      "visual_direction": {
        "palette": "Dawn / two separate city palettes",
        "framing": "Follow contributions from both cities into the same bridge.",
        "sound": "HQ radio enters after the last safe crossing."
      },
      "baseline_shot_ids": [
        "MS27_A",
        "MS27_B",
        "MS27_C",
        "MS27_D",
        "MS27_E",
        "MS27_F"
      ],
      "gameplay_entry": {
        "cut": "MS27_IN",
        "handoff": "settled final camera and reachable objective; use existing validated gameplay spawn",
        "spawn_override": null,
        "capture_party_snapshot": true
      },
      "gameplay_exit": {
