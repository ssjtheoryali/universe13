          "camera": "Emotional close-up / held reaction",
          "action": "Patch: You came back for them.",
          "performance_note": "Patch: hope to warmth; Terra: laugh; Ali: ease; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS18_D",
          "sequence": "MS18",
          "cut_id": "MS18_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Restore limb routes, dens and old gate; visit the hidden-base location on the main route.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_4_Storyboard.png"
        },
        {
          "shot_id": "MS18_E",
          "sequence": "MS18",
          "cut_id": "MS18_OUT",
