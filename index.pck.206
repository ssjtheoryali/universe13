      },
      "timing_status": "unlocked"
    },
    {
      "id": "MS13",
      "sequence": 13,
      "title": "The Fire That Would Not End",
      "locations": [
        "Ash Reach",
        "Ember Borough",
        "Ash Canyons",
        "Shattered Wastes",
        "Canyon Room",
        "Static Deadwood"
      ],
      "opening": "Forge Titan reheats an abandoned battle to keep proving its usefulness.",
      "objective": "Cross Ember Borough, canyons, wastes and deadwood; cleanse Titan, gather Ember fragments and Lava Javelin; free Target after Cinder Behemoth.",
      "outcome": "The furnace becomes a hearth. Target chooses to help; Theory's relic gate is separate.",
      "map_records": [
        "room_canyonroom",
        "wt_canyon_rim",
        "shrine_canyon",
        "camp_deadwood"
      ],
      "additional_records": [
        {
          "id": "static_deadwood",
          "name": "THE STATIC DEADWOOD",
          "main_sequence": "MS13",
          "source": "story_map_data.gd",
          "section": "WOODS"
        },
        {
          "name": "SHATTERED WASTES",
          "main_sequence": "MS13",
          "source": "game/js/world_v4.js"
        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Ash Reach",
      "character_turn": "Its desire to protect now burns everything unfamiliar; Target is caught in the signal.",
      "dialogue": "Target: Point me at the thing hurting them.",
      "expression_cues": "Ali: empathy; Target: hostility to recognition",
      "party_event": "join:Target;unlock:Theory",
      "chapter": 3,
      "chapter_title": "The Desire Inside the Monster",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS13_A",
          "sequence": "MS13",
          "cut_id": "MS13_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "Forge Titan reheats an abandoned battle to keep proving its usefulness.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS13_B",
          "sequence": "MS13",
          "cut_id": "MS13_IN",
          "camera": "Medium two-shot / partner eyeline",
          "action": "Its desire to protect now burns everything unfamiliar; Target is caught in the signal.",
          "performance_note": "Use actual chosen companions; frame the tall human and small Chibi at a shared eyeline without changing their anatomy.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS13_C",
          "sequence": "MS13",
          "cut_id": "MS13_IN",
          "camera": "Emotional close-up / held reaction",
          "action": "Target: Point me at the thing hurting them.",
          "performance_note": "Ali: empathy; Target: hostility to recognition; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS13_D",
          "sequence": "MS13",
          "cut_id": "MS13_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Cross Ember Borough, canyons, wastes and deadwood; cleanse Titan, gather Ember fragments and Lava Javelin; free Target after Cinder Behemoth.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS13_E",
          "sequence": "MS13",
          "cut_id": "MS13_OUT",
          "camera": "Matched before/after landmark / reaction",
          "action": "The furnace becomes a hearth. Target chooses to help; Theory's relic gate is separate.",
          "performance_note": "Show the quest result only after its earned flag. Keep repair particles travelling to the recorded origin.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS13_F",
          "sequence": "MS13",
          "cut_id": "MS13_OUT",
          "camera": "Departure tracking / companion insert",
          "action": "Party change: join:Target;unlock:Theory. Carry the eyeline into A Caravan That Cannot Leave.",
          "performance_note": "Honour unavailable, temporarily absent and lost allies. Never invent a fixed party to fill the frame.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        }
      ],
      "script_blocks": [
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN",
          "text": "EXT. EMBER APPROACH - DAY. Forge Titan hammers the same ruined weapon without pause. Each strike ignites a lost battle across the furnace walls. Target is trapped beyond the heat."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TARGET",
          "text": "Do not stand there.",
          "line_id": "MS13_IN_D01"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "I was about to move.",
          "line_id": "MS13_IN_D02"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TARGET",
          "text": "Then do it before you explain it.",
          "line_id": "MS13_IN_D03"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "The Static jerks Target's aim toward him. She fights the movement by bracing against her own weapon line. Ali understands the warning was meant to protect him."
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TARGET",
          "text": "I am going to miss on purpose. Once. Make it useful.",
          "line_id": "MS13_IN_D04"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TARGET",
          "text": "He will not stop making a war that already ended.",
          "line_id": "MS13_IN_D05"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "TERRA",
          "text": "He thinks being useful means never cooling down.",
          "line_id": "MS13_IN_D06"
        },
        {
          "kind": "dialogue",
          "phase": "IN",
          "label": "ALI",
          "text": "We give him something worth keeping warm.",
          "line_id": "MS13_IN_D07"
        },
        {
          "kind": "action",
          "phase": "IN",
          "label": "IN_ACTION",
          "text": "Rose identifies a vent leading toward the captive. Ali and the chosen ally draw the Titan's attention away from it. Firelight shapes the armour; it never replaces model detail with glowing noise."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE",
          "text": "Cross Ember Borough, canyons, wastes and deadwood; vent the trapped heat, defeat Cinder Behemoth and free Target. Cleanse the Titan at the opened corruption point. Recover Ember fragments and the Lava Javelin through their actual separate interactions. Do not count the relic as another core."
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Cleanse Target through the source duel after opening the route beyond Cinder Behemoth. She drops the corrupted firing line before thanking anybody. Above them, the Forge Titan begins another hammer cycle."
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "It does not know how to stop.",
          "line_id": "MS13_BRIDGE_D01"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "ALI",
          "text": "You sound familiar with that.",
          "line_id": "MS13_BRIDGE_D02"
        },
        {
          "kind": "dialogue",
          "phase": "BRIDGE",
          "label": "TERRA",
          "text": "I am holding a live coupler. Pick a better moment.",
          "line_id": "MS13_BRIDGE_D03"
        },
        {
          "kind": "action",
          "phase": "BRIDGE",
          "label": "BRIDGE_ACTION",
          "text": "Ali accepts the rebuke. He takes the heat shield from her, leaving her free to direct the repair. She lets him keep it."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The furnace dims to a hearth. The Titan's hammer lowers; a repaired pipe now warms an occupied shelter instead of reheating weapons."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TARGET",
          "text": "I could get used to that kind of fire.",
          "line_id": "MS13_OUT_D01"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "It still has a purpose.",
          "line_id": "MS13_OUT_D02"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Just a better one.",
          "line_id": "MS13_OUT_D03"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TARGET",
          "text": "Bullseye. On the Static, this time.",
          "line_id": "MS13_OUT_D04"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ROSE",
          "text": "You do not owe us a lifetime for one rescue.",
          "line_id": "MS13_OUT_D05"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TARGET",
          "text": "Was not offering a lifetime. I was offering a good shot.",
          "line_id": "MS13_OUT_D06"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "We could use one.",
          "line_id": "MS13_OUT_D07"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "The furnace warms an occupied shelter. Terra starts checking a perfectly stable pipe. Ali waits beside her instead of telling her to relax."
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "TERRA",
          "text": "...It is holding.",
          "line_id": "MS13_OUT_D08"
        },
        {
          "kind": "dialogue",
          "phase": "OUT",
          "label": "ALI",
          "text": "Looks like.",
          "line_id": "MS13_OUT_D09"
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "OUT",
          "text": "She finally takes her hand off the tool."
        },
        {
          "kind": "action",
          "phase": "OUT",
          "label": "END_ACTION",
          "text": "Target offers to travel. Theory's field availability updates only after the proper relic condition. Ember fragments add a second family without completing the six."
        }
      ],
      "visual_direction": {
        "palette": "Motivated furnace amber / cooler rescue vent",
        "framing": "Show weapon heat redirected into inhabited shelter warmth.",
        "sound": "Hammer cycle ends; a safe pipe ticks as it cools."
      },
      "baseline_shot_ids": [
        "MS13_A",
        "MS13_B",
        "MS13_C",
        "MS13_D",
