      "additional_records": [
        {
          "name": "DOCKS & FREIGHT",
          "main_sequence": "MS15",
          "source": "game/js/world_v4.js"
        }
      ],
      "legacy_anchors": [],
      "realm": "CHIBI / Tidecall",
      "character_turn": "His desire to bring everyone home traps the docks at departure.",
      "dialogue": "Rose: Let them make the crossing.",
      "expression_cues": "Rose: empathy; Captain: grief to release; Pinto: resolve",
      "party_event": "join:Pinto",
      "chapter": 3,
      "chapter_title": "The Desire Inside the Monster",
      "homeward_purpose": "Advance the connected route to Ali and Rose's own reality; local repairs remove a specific obstruction or recover the next fragment, signal or return coordinate.",
      "shots": [
        {
          "shot_id": "MS15_A",
          "sequence": "MS15",
          "cut_id": "MS15_IN",
          "camera": "Establishing wide / travelling camera",
          "action": "A bell calls through freight lanes; the Captain holds a ship with no living passengers.",
          "performance_note": "Establish the travel axis and one recognisable damaged landmark. Preserve separate Real and Chibi visual scales.",
          "start_frame": null,
