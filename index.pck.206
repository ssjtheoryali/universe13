          "camera": "Emotional close-up / held reaction",
          "action": "Ali: Come if this is your road too.",
          "performance_note": "Ali: invitation; recruits: individual trust; allow a silent listening beat before the gameplay handoff.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
        },
        {
          "shot_id": "MS12_D",
          "sequence": "MS12",
          "cut_id": "MS12_BRIDGE",
          "camera": "Action wide / readable objective geography",
          "action": "Reconnect Static Crossing, Brightwater, Juevy Junction, Critter Lake, residential roads, Wilds and cliffs.",
          "performance_note": "Continuous film: animate the successful main quest. Game: replace this shot with player control; do not award completion for watching it.",
          "start_frame": null,
          "end_frame_exclusive": null,
          "illustration": "illustrations/Act_3_Storyboard.png"
