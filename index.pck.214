 "schema": "u13.fairy_species.v1",
 "status": "test",
 "status_note": "SYSTEM TEST creature for the fairy kit + fauna AI. Not final art, not on Theory's approved roster.",
 "id": "auramote",
 "name": "Auramote",
 "plan": "floater",
 "lore": "A drifting bell of soft light that feeds on loose ki in the air. Small drifts gather over still water at dusk and pulse together.",
 "size_m": 0.6,
 "proportions": {"bell": 1.0, "bell_h": 0.42, "tentacles": 6, "tentacle": 0.9, "rims": 6},
 "colors": {"body": "#F6B8D8", "belly": "#FFE6F2", "accent": "#C77DCB", "accent2": "#FFD9F0", "eye": "#3A1E3E", "glow": "#FFF0A8"},
 "parts": {"wings": "none", "tail": "none", "horns": "none", "fins": "none", "legs": 0, "ears": "none", "eyes": "big", "pattern": "plain", "extras": []},
 "biology": {
  "habitat": ["pond", "meadow", "sky_island"], "biome": "still air over water, lit by the sunset",
  "diet": "ki-eater", "food": ["ambient ki", "pollen motes"],
  "activity": "crepuscular", "group": "flock", "group_size": [4, 7],
  "predators": [], "prey": [],
  "sleep_site": "drift", "nest": "no nest: the drift sinks low over the water and pulses slowly all night",
  "locomotion": ["air"], "drinks": false, "lifespan_years": 2, "size_class": "small",
  "notes": "Jet-pulse movement like a jellyfish (fast contraction, slow relax) through thick ki-rich air. No predators because the tentacles sting; it glows brighter when it has fed. Drifts with the wind when resting."
 },
 "behavior": {"temperament": "curious", "flight_distance": 2, "approach_distance": 3, "curiosity": 0.7, "aggression": 0.05, "play": 0.5, "groom": 0.2, "call": "chiming glow pulse", "call_times": ["dusk"], "hover_height": 2.2},
 "mega_morph": [
  {"stage": 1, "name": "Auramote"},
  {"stage": 2, "name": "Halomote", "scale": 1.6,
   "proportions": {"bell_h": 0.5, "tentacles": 8, "tentacle": 1.1, "rims": 8},
   "colors": {"body": "#D9C2FF", "accent": "#8F6CD8", "accent2": "#FFE9FF", "glow": "#FFF6C8"},
   "parts": {"extras_add": ["halo", "petals"]},
   "morph_ability": {"name": "Calm Pulse", "effect": "a soothing wave that ends fights between wild fairies and restores the squad's ki"},
   "trigger": {"type": "item", "detail": "drift through the Wish Spire's light at dusk"}}
 ]
}
␀␀␀␀␀␀␀␀␀{
 "schema": "u13.fairy_species.v1",
 "status": "test",
 "status_note": "SYSTEM TEST creature for the fairy kit + fauna AI. Not final art, not on Theory's approved roster.",
 "id": "brambleback",
 "name": "Brambleback",
 "plan": "crawler",
 "lore": "A many-legged leaf-litter fairy that lives in hive colonies inside fallen logs. It recycles dead leaves into rich soil and rolls into a thorny ball when threatened.",
 "size_m": 0.6,
 "proportions": {"segments": 6, "girth": 0.1, "leg": 0.1, "head": 0.1, "antenna": 0.35},
 "colors": {"body": "#B06A4A", "belly": "#F0D8B8", "accent": "#8A4A36", "accent2": "#6FA35A", "eye": "#1A1212", "dark": "#3E2A22", "claw": "#F4E6CC"},
 "parts": {"wings": "none", "tail": "none", "horns": "none", "fins": "none", "legs": 12, "ears": "none", "eyes": "small", "pattern": "plain", "extras": ["shell", "cerci"]},
 "biology": {
  "habitat": ["forest_edge", "forest"], "biome": "shady leaf litter around fallen logs",
  "diet": "herbivore", "food": ["dead leaves", "moss", "fungus"],
  "activity": "nocturnal", "group": "hive", "group_size": [5, 10],
  "predators": ["cirrusong", "tunnelpaw"], "prey": [],
  "sleep_site": "hive_log", "nest": "galleries inside one fallen log; the colony sleeps packed together",
  "locomotion": ["ground"], "drinks": true, "lifespan_years": 2, "size_class": "small",
  "notes": "Many short legs move in a wave from back to front (steady, strong pushing through litter). Avoids sun (dries out) so it forages at night near damp shade. Armoured back + curl-up defence like a pill bug."
 },
 "behavior": {"temperament": "calm", "flight_distance": 2, "curiosity": 0.2, "aggression": 0.05, "play": 0.15, "groom": 0.6, "call": "faint clicking", "call_times": ["night"]},
 "mega_morph": [
  {"stage": 1, "name": "Brambleback"},
  {"stage": 2, "name": "Thornbastion", "scale": 1.7,
   "proportions": {"segments": 7, "girth": 0.12, "leg": 0.12},
   "colors": {"body": "#8E5A40", "accent": "#5A3426", "accent2": "#9BD46A", "claw": "#FFF2D8"},
   "parts": {"extras_add": ["spikes", "stinger"]},
   "morph_ability": {"name": "Roll Guard", "effect": "rolls into a spiked wheel that blocks a path or bowls through brambles"},
   "trigger": {"type": "bond", "detail": "help a colony rebuild its log hive after a fire"}}
 ]
}
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀{
 "schema": "u13.fairy_species.v1",
