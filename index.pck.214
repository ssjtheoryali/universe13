 "id": "cirrusong",
 "name": "Cirrusong",
 "plan": "avian",
 "lore": "A small cloud-coloured songbird fairy. Flocks start the dawn chorus over the meadow; their song is said to blow the morning mist away.",
 "size_m": 0.26,
