ë1šÕ<½ûjl	q¢ôôY•ÅÛ©3ÎfœŸƒ¨çsøsõ²ÿOîûî¦Äo‚uwˆR>yŠa”Ûõş€2QîéG´üÆ|O,ùÖÇWÜûª:¼.:Î"ı÷³NèmÆè]$ì8␀–‘=––?šÉKĞÜò¼©Lˆ}7½_ût–Ã+ú88ëÙä`òŒÊó÷UİĞ>®¼ØÔ«aÄºB8™ºëj5à³+Ïwñï]Õ/ØÙÖ}¢w=²¼7xô…•Çwê¹x'ù>bK/•Ü\Í3Uš1jØµúUÏ¼î¾şşš{ÿõ[÷QÁ?‚‹šË‹Tu³¾IQCßu¶4mja+s»†0T[ı·+1ù×¥ŸübØóà¬£&2;Ød„6Qn¤_üO$>bèLß[Õ}–»äßş=ÑÅÀòM‰Ê…ÕZ§rÙ‡»‡ûÎ°²÷2÷eö¸/fı—Ÿ(Än"öçÿË$’ïUıû~¼¤ˆø␀␀// UNIVERSE 13 Â· ink outline (inverted hull) for the cel look: drawn as next_pass on buildings + landmarks in 4K mode.
shader_type spatial;
render_mode unshaded, cull_front, depth_draw_opaque;

uniform vec3 ink : source_color = vec3(0.13, 0.11, 0.16);
uniform float width = 0.06;          // metres at the model's own scale
uniform float far_fade = 260.0;      // outlines thin out with distance (no black mush on far hills)

void vertex() {
	vec3 wp = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	float d = length(wp - CAMERA_POSITION_WORLD);
	float w = width * clamp(1.0 - d / far_fade, 0.0, 1.0);
	VERTEX += NORMAL * w;
}

void fragment() {
	ALBEDO = ink;
}
